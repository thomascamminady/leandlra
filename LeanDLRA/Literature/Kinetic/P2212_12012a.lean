import LeanDLRA.Integrators.BUG
import LeanDLRA.Matrix.Projectors
import LeanDLRA.Novel.KineticAP
import LeanDLRA.Kinetic.Defs

/-!
# Results of arXiv 2212.12012: Asymptotic-preserving, energy-stable DLRA (Einkemmer-Hu-Kusch)

This module formalizes §3 to §5 of the paper for its actual scheme, not an abstract core: the modal
micro-macro `P_N` discretisation on a periodic grid (`Dp`, `Dm`, `transport`, `IsFullStep`), with
the splitting `A^± = ½ T (M ± |M|) Tᵀ` built from the genuine Gauss-Legendre rule (`IsGaussRule`,
which exists for every `N` by `exists_isGaussRule`), and the fully discrete fixed-rank BUG step of
§5.2, which is `KineticAP.IsMicroMacroBUGStep` for `𝒯 = transport`, `d = D⁺ρⁿ`, with the macro
update (5.4). Proved: Lemma 3.3 (`sbp_Dp`, `sbp_Dm`); Lemma 3.4 (`lemma_3_4_abs`, `lemma_3_4_aa`,
`lemma_3_4_sq`); Lemma 3.5 (`inner_transport_self`, `inner_transport_self_nonneg`,
`inner_transport_step`); Lemma 3.6 (`lemma_3_6`); Theorem 3.2 (`energy_stable_of_cfl`,
`energy_stable`); Theorem 4.1 (`theorem_4_1`, `theorem_4_1_run`); Theorem 5.1 (`energy_identity`,
`energy_dissipation`); Theorem 5.2 (`energy_stable_dlra_of_cfl`, `energy_stable_dlra`).

## False as printed, each with a formal counterexample

* Lemma 3.4, `gᵀ A² g = ĥᵀ M² ĥ`: the right side is `gᵀ (A² + a aᵀ) g` (`lemma_3_4_printed_false`,
  for every `N ≥ 1`).
* Lemma 3.5, (3.11): the last term needs `A⁺ D⁺ + A⁻ D⁻`, not `𝓛 = A⁺ D⁻ + A⁻ D⁺`
  (`lemma_3_5_printed_false`).
* Lemma 3.6: the bound needs `A² + a aᵀ`, not `A²` (`lemma_3_6_printed_false`, `P₁` on two cells).
* Theorem 5.1: the rate is `-σ₀ ‖gˢ‖²`, not `-σ₀ ε⁻² ‖gˢ‖²` (`theorem_5_1_printed_false`, `ε < 1`).
* Theorem 4.1: see below (`theorem_4_1_printed_false`).

The first three do not hurt Theorem 3.2: its conclusion and its CFL condition survive with the
corrected lemmas, and so does Theorem 5.2, whose proof reduces to it.

## Theorem 4.1

The printed statement has no hypothesis: "in the limit `ε → 0`, the proposed method preserves the
semi-discrete diffusion equation (4.9)". The invertibility appears only inside the proof: if
`L^{n+1} = V^{n+1} S_L` and `S_L ⟨Xⁿ Xⁿᵀ σ⟩` is invertible, then `σ⁻¹ ∂ₓρⁿ` and `a` lie in the new
bases, where `L^{n+1}` solves the limit equation `L^{n+1} ⟨Xⁿ Xⁿᵀ σ⟩ = -a ⟨∂ₓρ, Xⁿᵀ⟩`. The report of
`KineticAP.not_isUnit_of_lLimit_eq` is right, and it holds in every setting, not only in some: the
right side has rank at most one, so for every `r ≥ 2` and all data the hypothesis is unsatisfiable.
Read at `ε > 0` instead, the inverse is unbounded as `ε → 0` (`printed_hypothesis_not_uniform`). At
`r = 1` the hypothesis can hold and gives `a ∈ range Vⁿ⁺¹`, but it says nothing about `σ⁻¹ ∂ₓρⁿ ∈
range Xⁿ⁺¹`, which comes from the `K`-step and needs `aᵀ Vⁿ ≠ 0`. So the theorem is false as
printed, for the paper's own scheme, even with the hypothesis of its proof
(`theorem_4_1_printed_false`), and true under `aᵀ Vⁿ ≠ 0` and `⟨∂ₓρⁿ, Xⁿ⟩ ≠ 0` (`theorem_4_1`). For
a whole run these conditions are needed at time `0` only (`theorem_4_1_run`, from
`KineticAP.ap_run`).

## Differences from the paper, and what is left

The grid is periodic, as the printed summations by parts need. Theorem 4.1 is stated in the fully
discrete setting of §5.2, with `∂ₓ` realised by `D⁺` on `ρ` and `D⁻` on interface fluxes, because
Mathlib has no setting for the semi-discrete §4. The factor `σ` in front of the bracket in (4.5),
(4.6) is read as a misprint, as in §5.2 and in the proof of Theorem 4.1. The library's step allows
any orthonormal bases capturing `K` and `L`, which includes the QR factors of the paper. The
constant `C = 1 / (4 (N + 2))` of (3.7) depends on `N`; the paper's remark that `(N + 1) w_k` stays
bounded, which would remove that, is not formalized. The counterexample to Theorem 4.1 has `r = 1`,
where the printed hypothesis can hold; one with `r ≥ 2` is not formalized. The algebra of the
printed proof is `KineticAP.sLimit_eq_diffFlux_iff`, not repeated here.

Core vocabulary: a Gauss rule gives a core quadrature `Kinetic.Quadrature` of
`LeanDLRA/Kinetic/Defs.lean` with the halved weights `w_k / 2` (`IsGaussRule.toQuadrature`; the
weights of a Gauss rule have sum two, `IsGaussRule.sum_weight_eq_two`).
-/

open Set Filter Topology Finset
open scoped RealInnerProductSpace Matrix

namespace LeanDLRA.Literature.P2212_12012

section Legendre

/-- The recurrence coefficient `a_l = (l + 1) / √((2 l + 1) (2 l + 3))` of (2.3). -/
noncomputable def coef (l : ℕ) : ℝ := ((l : ℝ) + 1) / √((2 * (l : ℝ) + 1) * (2 * (l : ℝ) + 3))

theorem coef_pos (l : ℕ) : 0 < coef l := by
  have h : 0 < (2 * (l : ℝ) + 1) * (2 * (l : ℝ) + 3) := by positivity
  exact div_pos (by positivity) (Real.sqrt_pos.2 h)

theorem coef_zero_sq : coef 0 ^ 2 = 1 / 3 := by
  simp only [coef, div_pow]
  rw [Real.sq_sqrt (by positivity)]
  norm_num

/-- The orthonormal Legendre polynomials, generated by the three-term recurrence (2.3) from
`p₀ = 1/√2`. -/
noncomputable def legendre : ℕ → ℝ → ℝ
  | 0, _ => 1 / √2
  | 1, x => x * (1 / √2) / coef 0
  | l + 2, x => (x * legendre (l + 1) x - coef l * legendre l x) / coef (l + 1)

theorem legendre_zero (x : ℝ) : legendre 0 x = 1 / √2 := rfl

theorem legendre_one (x : ℝ) : legendre 1 x = x * (1 / √2) / coef 0 := rfl

/-- (2.3) at `l = 0`. -/
theorem mul_legendre_zero (x : ℝ) : x * legendre 0 x = coef 0 * legendre 1 x := by
  rw [legendre_one, legendre_zero]
  field_simp [(coef_pos 0).ne']

/-- (2.3) at `l + 1`. -/
theorem mul_legendre_succ (l : ℕ) (x : ℝ) :
    x * legendre (l + 1) x = coef l * legendre l x + coef (l + 1) * legendre (l + 2) x := by
  have h : legendre (l + 2) x = (x * legendre (l + 1) x - coef l * legendre l x) / coef (l + 1) :=
    rfl
  rw [h, mul_div_cancel₀ _ (coef_pos (l + 1)).ne']
  ring

/-- The Jacobi matrix `A_f = (⟨μ p_i p_j⟩)_{i,j=0}^N` of the full `P_N` system. -/
noncomputable def jacobi (N : ℕ) : Matrix (Fin (N + 1)) (Fin (N + 1)) ℝ :=
  Matrix.of fun i j => if (i : ℕ) + 1 = j then coef i else if (j : ℕ) + 1 = i then coef j else 0

theorem jacobi_transpose (N : ℕ) : (jacobi N)ᵀ = jacobi N := by
  ext i j
  simp only [jacobi, Matrix.transpose_apply, Matrix.of_apply]
  split_ifs with h1 h2 h2 <;> first | rfl | omega

/-- One row of `jacobi` applied to a sequence: the three-term stencil. -/
theorem jacobi_row_sum (N : ℕ) (F : ℕ → ℝ) (i : Fin (N + 1)) :
    ∑ l : Fin (N + 1), jacobi N i l * F l =
      (if (i : ℕ) + 1 < N + 1 then coef i * F (i + 1) else 0) +
        (if _ : (i : ℕ) = 0 then 0 else coef (i - 1) * F (i - 1)) := by
  have hsplit : ∀ l : Fin (N + 1), jacobi N i l * F l =
      (if (i : ℕ) + 1 = l then coef i * F l else 0) +
        (if (l : ℕ) + 1 = i then coef l * F l else 0) := by
    intro l
    simp only [jacobi, Matrix.of_apply]
    split_ifs with h1 h2 h2 <;> first | omega | ring
  simp only [hsplit, Finset.sum_add_distrib]
  rw [Fin.sum_univ_eq_sum_range (fun l => if (i : ℕ) + 1 = l then coef i * F l else 0),
    Fin.sum_univ_eq_sum_range (fun l => if l + 1 = (i : ℕ) then coef l * F l else 0)]
  congr 1
  · rw [Finset.sum_ite_eq]
    simp only [Finset.mem_range]
  · by_cases h : (i : ℕ) = 0
    · simp [h]
    · obtain ⟨i', hi'⟩ := Nat.exists_eq_succ_of_ne_zero h
      have hlt : i' < N + 1 := by have := i.2; omega
      simp only [hi', Nat.succ_eq_add_one, Nat.add_eq_zero_iff, one_ne_zero, and_false,
        dite_false, Nat.add_sub_cancel]
      rw [Finset.sum_eq_single_of_mem i' (Finset.mem_range.2 hlt)]
      · simp
      · intro b _ hb
        have hb' : ¬ b + 1 = i' + 1 := by simpa using hb
        simp only [hb', ite_false]

/-- (2.3) with the convention `a_{-1} p_{-1} = 0`. -/
theorem mul_legendre (i : ℕ) (x : ℝ) : x * legendre i x =
    coef i * legendre (i + 1) x + (if _ : i = 0 then 0 else coef (i - 1) * legendre (i - 1) x) := by
  rcases i with _ | i
  · simpa using mul_legendre_zero x
  · rw [mul_legendre_succ]
    simp only [Nat.add_eq_zero_iff, one_ne_zero, and_false, dite_false, Nat.add_sub_cancel]
    ring

/-- The Legendre values at a root of `p_{N+1}` are an eigenvector of `jacobi N`. -/
theorem jacobi_mul_legendre {N : ℕ} {x : ℝ} (hx : legendre (N + 1) x = 0) (i : Fin (N + 1)) :
    ∑ l : Fin (N + 1), jacobi N i l * legendre l x = x * legendre i x := by
  rw [jacobi_row_sum N (fun l => legendre l x) i, mul_legendre]
  by_cases hi : (i : ℕ) + 1 < N + 1
  · simp only [hi, ite_true]
  · have h2 : (i : ℕ) + 1 = N + 1 := by have := i.2; omega
    simp only [hi, ite_false]
    rw [h2, hx, mul_zero, zero_add]

/-- An eigenvector of `jacobi N` is a multiple of the Legendre values at the eigenvalue, and the
eigenvalue is a root of `p_{N+1}` unless the vector vanishes. -/
theorem eigenvector_eq {N : ℕ} {v : Fin (N + 1) → ℝ} {x : ℝ}
    (hv : ∀ i, ∑ l : Fin (N + 1), jacobi N i l * v l = x * v i) :
    (∀ i : Fin (N + 1), v i = √2 * v 0 * legendre i x) ∧ √2 * v 0 * legendre (N + 1) x = 0 := by
  set V : ℕ → ℝ := fun l => if h : l < N + 1 then v ⟨l, h⟩ else 0 with hV
  have hVv : ∀ i : Fin (N + 1), V i = v i := fun i => by
    have hi : (i : ℕ) ≤ N := by have := i.2; omega
    simp [hV, hi]
  have hs2 : (√2 : ℝ) ≠ 0 := by positivity
  set α := √2 * v 0 with hα
  have hrec : ∀ i : ℕ, i < N + 1 →
      coef i * V (i + 1) + (if _ : i = 0 then 0 else coef (i - 1) * V (i - 1)) = x * V i := by
    intro i hi
    have h1 := hv ⟨i, hi⟩
    have h2 : ∀ l : Fin (N + 1), jacobi N ⟨i, hi⟩ l * v l = jacobi N ⟨i, hi⟩ l * V l :=
      fun l => by rw [hVv]
    rw [Finset.sum_congr rfl fun l _ => h2 l, jacobi_row_sum N V ⟨i, hi⟩] at h1
    have h3 : V i = v ⟨i, hi⟩ := hVv ⟨i, hi⟩
    rw [h3, ← h1]
    by_cases hi1 : i + 1 < N + 1
    · simp only [hi1, ite_true]
    · have h4 : V (i + 1) = 0 := by
        have hi2 : ¬ i + 1 ≤ N := by omega
        simp [hV, hi2]
      simp only [hi1, ite_false, h4, mul_zero]
  have key : ∀ l : ℕ, l ≤ N + 1 → V l = α * legendre l x ∧ (l + 1 ≤ N + 1 → 
      V (l + 1) = α * legendre (l + 1) x) := by
    intro l
    induction l with
    | zero =>
      intro _
      have h0 : V 0 = v 0 := by simp [hV]
      have h00 : V 0 = α * legendre 0 x := by
        rw [h0, hα, legendre_zero]
        field_simp
      refine ⟨h00, fun hN => ?_⟩
      have h1 := hrec 0 (by omega)
      simp only [dite_true, add_zero] at h1
      have h2 := mul_legendre_zero x
      have hc := (coef_pos 0).ne'
      apply mul_left_cancel₀ hc
      rw [h1, h00]
      simp only [zero_add] at h2 ⊢
      rw [show coef 0 * (α * legendre 1 x) = α * (coef 0 * legendre 1 x) by ring, ← h2]
      ring
    | succ l ih =>
      intro hl
      obtain ⟨h1, h2⟩ := ih (by omega)
      refine ⟨h2 hl, fun hN => ?_⟩
      have h3 := hrec (l + 1) (by omega)
      simp only [Nat.add_eq_zero_iff, one_ne_zero, and_false, dite_false,
        Nat.add_sub_cancel] at h3
      have h4 := mul_legendre_succ l x
      have hc := (coef_pos (l + 1)).ne'
      apply mul_left_cancel₀ hc
      have h5 : coef (l + 1) * V (l + 1 + 1) = x * V (l + 1) - coef l * V l := by linarith
      rw [h5, h2 hl, h1]
      rw [show coef (l + 1) * (α * legendre (l + 1 + 1) x) =
        α * (coef (l + 1) * legendre (l + 2) x) by ring]
      linear_combination α * h4
  constructor
  · intro i
    rw [← hVv]
    exact (key i (by have := i.2; omega)).1
  · have h1 := (key (N + 1) le_rfl).1
    have h2 : V (N + 1) = 0 := by simp [hV]
    rw [← h1, h2]

/-- **The Gauss-Legendre rule with `N + 1` nodes**: positive weights, nodes at the roots of
`p_{N+1}`, and quadrature exact on the products `p_i p_j`, `i, j ≤ N`.  This is all that §3 of
arXiv 2212.12012 uses of it; `exists_isGaussRule` shows that such a rule exists for every `N`. -/
structure IsGaussRule (N : ℕ) (μ w : Fin (N + 1) → ℝ) : Prop where
  weight_pos : ∀ k, 0 < w k
  root : ∀ k, legendre (N + 1) (μ k) = 0
  orthonormal : ∀ i j : Fin (N + 1),
    ∑ k, w k * legendre i (μ k) * legendre j (μ k) = if i = j then 1 else 0

/-- **Golub-Welsch.**  The Gauss-Legendre rule of §3 exists for every `N`: its nodes are the
eigenvalues of `jacobi N`, its weights the squared first components of the normalised
eigenvectors. -/
theorem exists_isGaussRule (N : ℕ) : ∃ μ w : Fin (N + 1) → ℝ, IsGaussRule N μ w := by
  have hJ : (jacobi N).IsHermitian := by
    rw [Matrix.IsHermitian, Matrix.conjTranspose_eq_transpose_of_trivial, jacobi_transpose]
  set Q : Matrix (Fin (N + 1)) (Fin (N + 1)) ℝ :=
    (hJ.eigenvectorUnitary : Matrix (Fin (N + 1)) (Fin (N + 1)) ℝ) with hQ
  have hQQ : Q * Qᵀ = 1 := by
    have := Unitary.coe_mul_star_self hJ.eigenvectorUnitary
    rwa [Unitary.coe_star, Matrix.star_eq_conjTranspose,
      Matrix.conjTranspose_eq_transpose_of_trivial] at this
  have hev : ∀ k i, ∑ l : Fin (N + 1), jacobi N i l * Q l k = hJ.eigenvalues k * Q i k := by
    intro k i
    have h1 := congrFun (hJ.mulVec_eigenvectorBasis k) i
    simp only [Matrix.mulVec, dotProduct, Pi.smul_apply, smul_eq_mul] at h1
    simpa only [hQ, Matrix.IsHermitian.eigenvectorUnitary_apply] using h1
  have hstruct := fun k => eigenvector_eq (v := fun i => Q i k) (hev k)
  refine ⟨hJ.eigenvalues, fun k => (√2 * Q 0 k) ^ 2, ?_⟩
  have hne : ∀ k, √2 * Q 0 k ≠ 0 := by
    intro k h0
    have hcol : ∀ i, Q i k = 0 := fun i => by
      rw [(hstruct k).1 i, h0, zero_mul]
    have h1 : (Qᵀ * Q) k k = 1 := by
      rw [mul_eq_one_comm.1 hQQ, Matrix.one_apply_eq]
    simp [Matrix.mul_apply, hcol] at h1
  refine ⟨fun k => by have := hne k; positivity, fun k => ?_, fun i j => ?_⟩
  · exact (mul_eq_zero.1 (hstruct k).2).resolve_left (hne k)
  · have h1 := congrFun (congrFun hQQ i) j
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply] at h1
    rw [← h1]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [(hstruct k).1 i, (hstruct k).1 j]
    ring

end Legendre

open LeanDLRA LeanDLRA.Novel.KineticAP
open scoped LeanDLRA.Frobenius

section Quadrature

variable {N : ℕ} (μ w : Fin (N + 1) → ℝ)

/-- `T_f = (√w_k p_{i-1}(μ_k))_{i,k=1}^{N+1}`, before Lemma 3.4. -/
noncomputable def Tf : Matrix (Fin (N + 1)) (Fin (N + 1)) ℝ :=
  Matrix.of fun i k => √(w k) * legendre i (μ k)

/-- `T ∈ ℝ^{N × (N+1)}`, `T_{ik} = √w_k p_i(μ_k)`, `i = 1, …, N`, of §3. -/
noncomputable def T : Matrix (Fin N) (Fin (N + 1)) ℝ :=
  Matrix.of fun i k => √(w k) * legendre ((i : ℕ) + 1) (μ k)

/-- `T₀ = (√w_k p₀(μ_k))_k = (√(w_k / 2))_k`, in the proof of Lemma 3.6. -/
noncomputable def T₀ : Matrix (Fin (N + 1)) Unit ℝ :=
  Matrix.of fun k _ => √(w k) * legendre 0 (μ k)

/-- `M = diag(μ_1, …, μ_{N+1})`. -/
noncomputable def nodeM : Matrix (Fin (N + 1)) (Fin (N + 1)) ℝ := Matrix.diagonal μ

/-- `|M| = diag(|μ_1|, …, |μ_{N+1}|)`. -/
noncomputable def absM : Matrix (Fin (N + 1)) (Fin (N + 1)) ℝ := Matrix.diagonal fun k => |μ k|

/-- The flux matrix `A = T M Tᵀ` of (3.1); by `fluxA_apply` it is the tridiagonal matrix (2.7). -/
noncomputable def fluxA : Matrix (Fin N) (Fin N) ℝ := T μ w * nodeM μ * (T μ w)ᵀ

/-- The stabilisation `|A| := T |M| Tᵀ` of §3.  It is not the matrix absolute value of `A`
(Remark 3.1). -/
noncomputable def absA : Matrix (Fin N) (Fin N) ℝ := T μ w * absM μ * (T μ w)ᵀ

/-- `A⁺ := ½ T (M + |M|) Tᵀ`. -/
noncomputable def plusA : Matrix (Fin N) (Fin N) ℝ :=
  (1 / 2 : ℝ) • (T μ w * (nodeM μ + absM μ) * (T μ w)ᵀ)

/-- `A⁻ := ½ T (M - |M|) Tᵀ`. -/
noncomputable def minusA : Matrix (Fin N) (Fin N) ℝ :=
  (1 / 2 : ℝ) • (T μ w * (nodeM μ - absM μ) * (T μ w)ᵀ)

/-- The vector `a = (a₀, 0, …, 0)ᵀ` of (2.7). -/
noncomputable def aVec (N : ℕ) : Matrix (Fin N) Unit ℝ :=
  Matrix.of fun i _ => if (i : ℕ) = 0 then coef 0 else 0

theorem plusA_add_minusA : plusA μ w + minusA μ w = fluxA μ w := by
  simp only [plusA, minusA, fluxA, Matrix.mul_add, Matrix.add_mul, Matrix.mul_sub, Matrix.sub_mul,
    ← smul_add]
  rw [show T μ w * nodeM μ * (T μ w)ᵀ + T μ w * absM μ * (T μ w)ᵀ +
      (T μ w * nodeM μ * (T μ w)ᵀ - T μ w * absM μ * (T μ w)ᵀ) =
      (2 : ℝ) • (T μ w * nodeM μ * (T μ w)ᵀ) by rw [two_smul]; abel, smul_smul]
  norm_num

theorem plusA_sub_minusA : plusA μ w - minusA μ w = absA μ w := by
  simp only [plusA, minusA, absA, Matrix.mul_add, Matrix.add_mul, Matrix.mul_sub, Matrix.sub_mul,
    ← smul_sub]
  rw [show T μ w * nodeM μ * (T μ w)ᵀ + T μ w * absM μ * (T μ w)ᵀ -
      (T μ w * nodeM μ * (T μ w)ᵀ - T μ w * absM μ * (T μ w)ᵀ) =
      (2 : ℝ) • (T μ w * absM μ * (T μ w)ᵀ) by rw [two_smul]; abel, smul_smul]
  norm_num

theorem nodeM_transpose : (nodeM μ)ᵀ = nodeM μ := Matrix.diagonal_transpose _

theorem absM_transpose : (absM μ)ᵀ = absM μ := Matrix.diagonal_transpose _

theorem fluxA_transpose : (fluxA μ w)ᵀ = fluxA μ w := by
  simp only [fluxA, Matrix.transpose_mul, Matrix.transpose_transpose, nodeM_transpose,
    Matrix.mul_assoc]

theorem absA_transpose : (absA μ w)ᵀ = absA μ w := by
  simp only [absA, Matrix.transpose_mul, Matrix.transpose_transpose, absM_transpose,
    Matrix.mul_assoc]

theorem plusA_transpose : (plusA μ w)ᵀ = plusA μ w := by
  simp only [plusA, Matrix.transpose_smul, Matrix.transpose_mul, Matrix.transpose_transpose,
    Matrix.transpose_add, nodeM_transpose, absM_transpose, Matrix.mul_assoc]

theorem minusA_transpose : (minusA μ w)ᵀ = minusA μ w := by
  simp only [minusA, Matrix.transpose_smul, Matrix.transpose_mul, Matrix.transpose_transpose,
    Matrix.transpose_sub, nodeM_transpose, absM_transpose, Matrix.mul_assoc]

variable {μ w}

namespace IsGaussRule

theorem mul_sqrt_self (hG : IsGaussRule N μ w) (k : Fin (N + 1)) : √(w k) * √(w k) = w k :=
  Real.mul_self_sqrt (hG.weight_pos k).le

/-- Quadrature exactness on `μ p_i p_j`: the first equality of (3.1). -/
theorem moment (hG : IsGaussRule N μ w) (i j : Fin (N + 1)) :
    ∑ k, w k * μ k * legendre i (μ k) * legendre j (μ k) = jacobi N i j := by
  have h1 : ∀ k, w k * μ k * legendre i (μ k) * legendre j (μ k) =
      ∑ l : Fin (N + 1), jacobi N i l * (w k * legendre l (μ k) * legendre j (μ k)) := by
    intro k
    have h2 := jacobi_mul_legendre (hG.root k) i
    calc _ = w k * (μ k * legendre i (μ k)) * legendre j (μ k) := by ring
      _ = _ := by
        rw [← h2, Finset.mul_sum, Finset.sum_mul]
        exact Finset.sum_congr rfl fun l _ => by ring
  rw [Finset.sum_congr rfl fun k _ => h1 k, Finset.sum_comm]
  simp only [← Finset.mul_sum, hG.orthonormal]
  simp

theorem Tf_mul_transpose (hG : IsGaussRule N μ w) : Tf μ w * (Tf μ w)ᵀ = 1 := by
  ext i j
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Tf, Matrix.of_apply, Matrix.one_apply]
  rw [← hG.orthonormal i j]
  refine Finset.sum_congr rfl fun k _ => ?_
  calc _ = (√(w k) * √(w k)) * legendre i (μ k) * legendre j (μ k) := by ring
    _ = _ := by rw [hG.mul_sqrt_self]

theorem transpose_mul_Tf (hG : IsGaussRule N μ w) : (Tf μ w)ᵀ * Tf μ w = 1 :=
  mul_eq_one_comm.1 hG.Tf_mul_transpose

theorem T_eq (i : Fin N) (k : Fin (N + 1)) : T μ w i k = Tf μ w i.succ k := by
  simp [T, Tf]

theorem T₀_eq (k : Fin (N + 1)) (u : Unit) : T₀ μ w k u = Tf μ w 0 k := by
  simp [T₀, Tf]

/-- `T Tᵀ = I_N`. -/
theorem T_mul_transpose (hG : IsGaussRule N μ w) : T μ w * (T μ w)ᵀ = 1 := by
  ext i j
  have h := congrFun (congrFun hG.Tf_mul_transpose i.succ) j.succ
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply, T_eq] at h ⊢
  simpa using h

/-- `Tᵀ T = I - T₀ T₀ᵀ`, in the proof of Lemma 3.6. -/
theorem transpose_mul_T (hG : IsGaussRule N μ w) :
    (T μ w)ᵀ * T μ w = 1 - T₀ μ w * (T₀ μ w)ᵀ := by
  ext k l
  have h := congrFun (congrFun hG.transpose_mul_Tf k) l
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Fin.sum_univ_succ] at h
  simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.sub_apply, T_eq, T₀_eq,
    Finset.univ_unique, Finset.sum_singleton]
  rw [← h]
  ring

theorem fluxA_eq (hG : IsGaussRule N μ w) (i j : Fin N) :
    fluxA μ w i j = jacobi N i.succ j.succ := by
  rw [← hG.moment, fluxA, nodeM, Matrix.mul_apply]
  simp only [Matrix.mul_diagonal, Matrix.transpose_apply, T_eq]
  refine Finset.sum_congr rfl fun k _ => ?_
  simp only [Tf, Matrix.of_apply]
  linear_combination (μ k * legendre (i.succ : ℕ) (μ k) * legendre (j.succ : ℕ) (μ k)) *
    hG.mul_sqrt_self k

/-- `A` is the matrix (2.7): zero diagonal, off-diagonal entries `a_1, …, a_{N-1}`. -/
theorem fluxA_apply (hG : IsGaussRule N μ w) (i j : Fin N) :
    fluxA μ w i j = if (i : ℕ) + 1 = j then coef ((i : ℕ) + 1)
      else if (j : ℕ) + 1 = i then coef ((j : ℕ) + 1) else 0 := by
  rw [hG.fluxA_eq]
  simp only [jacobi, Matrix.of_apply, Fin.val_succ, add_left_inj]

/-- `T M T₀ = a`: the identity behind the correction of Lemma 3.4. -/
theorem T_mul_nodeM_mul_T₀ (hG : IsGaussRule N μ w) : T μ w * nodeM μ * T₀ μ w = aVec N := by
  ext i u
  have h := hG.moment i.succ 0
  simp only [Fin.val_succ, Fin.val_zero, jacobi, Matrix.of_apply] at h
  rw [nodeM, Matrix.mul_apply]
  simp only [Matrix.mul_diagonal, T_eq, T₀_eq, aVec, Matrix.of_apply]
  have h2 : ∑ k, Tf μ w i.succ k * μ k * Tf μ w 0 k =
      ∑ k, w k * μ k * legendre ((i : ℕ) + 1) (μ k) * legendre 0 (μ k) := by
    refine Finset.sum_congr rfl fun k _ => ?_
    simp only [Tf, Matrix.of_apply, Fin.val_succ, Fin.val_zero]
    linear_combination (μ k * legendre ((i : ℕ) + 1) (μ k) * legendre 0 (μ k)) *
      hG.mul_sqrt_self k
  rw [h2, h]
  by_cases hi : (i : ℕ) = 0 <;> simp [hi]

/-- `T M² Tᵀ = A² + a aᵀ`.  Lemma 3.4 and Lemma 3.6 drop the second term. -/
theorem T_sq_T (hG : IsGaussRule N μ w) :
    T μ w * (nodeM μ * nodeM μ) * (T μ w)ᵀ = fluxA μ w * fluxA μ w + aVec N * (aVec N)ᵀ := by
  have h1 : fluxA μ w * fluxA μ w = T μ w * nodeM μ * ((T μ w)ᵀ * T μ w) * nodeM μ * (T μ w)ᵀ := by
    simp only [fluxA, Matrix.mul_assoc]
  have h2 : aVec N * (aVec N)ᵀ =
      T μ w * nodeM μ * (T₀ μ w * (T₀ μ w)ᵀ) * nodeM μ * (T μ w)ᵀ := by
    rw [← hG.T_mul_nodeM_mul_T₀]
    simp only [Matrix.transpose_mul, nodeM_transpose, Matrix.mul_assoc]
  rw [h1, h2, hG.transpose_mul_T]
  simp only [Matrix.mul_sub, Matrix.sub_mul, Matrix.mul_one, Matrix.mul_assoc]
  abel

/-- `(T₀)_k² = w_k / 2`. -/
theorem T₀_sq (hG : IsGaussRule N μ w) (k : Fin (N + 1)) (u : Unit) :
    T₀ μ w k u ^ 2 = w k / 2 := by
  simp only [T₀, Matrix.of_apply, legendre_zero, mul_pow, div_pow, one_pow]
  rw [Real.sq_sqrt (hG.weight_pos k).le, Real.sq_sqrt (by norm_num)]
  ring

end IsGaussRule

end Quadrature

section Grid

variable (Nx : ℕ) [NeZero Nx]

/-- The stencil `(D⁺ u)_j = (u_{j+1} - u_j) / Δx` of (3.4), periodic, as a matrix. -/
noncomputable def Dp (Δx : ℝ) : Matrix (ZMod Nx) (ZMod Nx) ℝ :=
  Matrix.of fun i j => ((if j = i + 1 then 1 else 0) - (if j = i then 1 else 0)) / Δx

/-- The stencil `(D⁻ u)_j = (u_j - u_{j-1}) / Δx` of (3.4), periodic, as a matrix. -/
noncomputable def Dm (Δx : ℝ) : Matrix (ZMod Nx) (ZMod Nx) ℝ :=
  Matrix.of fun i j => ((if j = i then 1 else 0) - (if j = i - 1 then 1 else 0)) / Δx

variable {Nx} {n : Type*} {Δx : ℝ}

theorem Dp_mul_apply (g : Matrix (ZMod Nx) n ℝ) (j : ZMod Nx) (l : n) :
    (Dp Nx Δx * g) j l = (g (j + 1) l - g j l) / Δx := by
  have h : ∀ b, Dp Nx Δx j b * g b l =
      ((if b = j + 1 then g b l else 0) - (if b = j then g b l else 0)) / Δx := by
    intro b
    simp only [Dp, Matrix.of_apply]
    split_ifs <;> ring
  rw [Matrix.mul_apply, Finset.sum_congr rfl fun b _ => h b, ← Finset.sum_div,
    Finset.sum_sub_distrib]
  simp

theorem Dm_mul_apply (g : Matrix (ZMod Nx) n ℝ) (j : ZMod Nx) (l : n) :
    (Dm Nx Δx * g) j l = (g j l - g (j - 1) l) / Δx := by
  have h : ∀ b, Dm Nx Δx j b * g b l =
      ((if b = j then g b l else 0) - (if b = j - 1 then g b l else 0)) / Δx := by
    intro b
    simp only [Dm, Matrix.of_apply]
    split_ifs <;> ring
  rw [Matrix.mul_apply, Finset.sum_congr rfl fun b _ => h b, ← Finset.sum_div,
    Finset.sum_sub_distrib]
  simp

omit [NeZero Nx] in
/-- The periodic stencils are skew-adjoint to each other: Lemma 3.3 in matrix form. -/
theorem Dm_transpose : (Dm Nx Δx)ᵀ = -Dp Nx Δx := by
  ext i j
  have h : i = j - 1 ↔ j = i + 1 := by
    constructor
    · rintro rfl
      simp
    · rintro rfl
      simp
  simp only [Dm, Dp, Matrix.transpose_apply, Matrix.of_apply, Matrix.neg_apply, h]
  by_cases h2 : i = j
  · subst h2
    simp only [ite_true]
    ring
  · have h3 : ¬ j = i := fun h4 => h2 h4.symm
    simp only [h2, h3, ite_false]
    ring

omit [NeZero Nx] in
theorem Dp_transpose : (Dp Nx Δx)ᵀ = -Dm Nx Δx := by
  rw [← neg_eq_iff_eq_neg, ← Matrix.transpose_neg, ← Dm_transpose, Matrix.transpose_transpose]

theorem sum_add_one (f : ZMod Nx → ℝ) : ∑ j, f (j + 1) = ∑ j, f j :=
  Equiv.sum_comp (Equiv.addRight (1 : ZMod Nx)) f

theorem sum_sub_one (f : ZMod Nx → ℝ) : ∑ j, f (j - 1) = ∑ j, f j :=
  Equiv.sum_comp (Equiv.subRight (1 : ZMod Nx)) f

theorem Dm_mul_apply_eq (g : Matrix (ZMod Nx) n ℝ) (j : ZMod Nx) (l : n) :
    (Dm Nx Δx * g) j l = (Dp Nx Δx * g) (j - 1) l := by
  rw [Dm_mul_apply, Dp_mul_apply, sub_add_cancel]

variable [Fintype n]

theorem norm_Dm_mul (g : Matrix (ZMod Nx) n ℝ) : ‖Dm Nx Δx * g‖ = ‖Dp Nx Δx * g‖ := by
  have h : ‖Dm Nx Δx * g‖ ^ 2 = ‖Dp Nx Δx * g‖ ^ 2 := by
    rw [Frobenius.norm_sq_eq_sum, Frobenius.norm_sq_eq_sum]
    simp only [Dm_mul_apply_eq]
    exact sum_sub_one fun j => ∑ l, (Dp Nx Δx * g) j l ^ 2
  exact (sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _)).1 h

omit [Fintype n] in
/-- `D⁺ - D⁻ = Δx D⁻ D⁺`. -/
theorem Dp_sub_Dm (hΔx : Δx ≠ 0) (g : Matrix (ZMod Nx) n ℝ) :
    Dp Nx Δx * g - Dm Nx Δx * g = Δx • (Dm Nx Δx * (Dp Nx Δx * g)) := by
  ext j l
  simp only [Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul, Dp_mul_apply, Dm_mul_apply,
    sub_add_cancel]
  field_simp

omit [Fintype n] in
/-- `‖D⁺ u‖² ≤ 4 ‖u‖² / Δx²`, column by column; the last inequality of the proof of Theorem 3.2. -/
theorem sum_Dp_sq_le (g : Matrix (ZMod Nx) n ℝ) (l : n) :
    ∑ j, (Dp Nx Δx * g) j l ^ 2 ≤ 4 / Δx ^ 2 * ∑ j, g j l ^ 2 := by
  have h : ∀ j, (Dp Nx Δx * g) j l ^ 2 ≤ 2 / Δx ^ 2 * (g (j + 1) l ^ 2 + g j l ^ 2) := by
    intro j
    rw [Dp_mul_apply, div_pow, div_mul_eq_mul_div]
    gcongr
    nlinarith [sq_nonneg (g (j + 1) l + g j l)]
  refine (Finset.sum_le_sum fun j _ => h j).trans_eq ?_
  rw [← Finset.mul_sum, Finset.sum_add_distrib, sum_add_one fun j => g j l ^ 2]
  ring

/-- **Lemma 3.3 (summation by parts)**, arXiv 2212.12012, for `D⁺`, on a periodic grid (the "index
shift" of the printed proof needs periodicity):
`∑_j k_jᵀ D⁺ g_j = -∑_j (D⁻ k_j)ᵀ g_j`.  The Frobenius inner product is `∑_j k_jᵀ g_j`. -/
theorem sbp_Dp (k g : Matrix (ZMod Nx) n ℝ) : ⟪k, Dp Nx Δx * g⟫ = -⟪Dm Nx Δx * k, g⟫ := by
  rw [Frobenius.inner_mul_left, Dm_transpose, Matrix.neg_mul, inner_neg_right, neg_neg]

/-- **Lemma 3.3 (summation by parts)**, arXiv 2212.12012, for `D⁻`: see `sbp_Dp`. -/
theorem sbp_Dm (k g : Matrix (ZMod Nx) n ℝ) : ⟪k, Dm Nx Δx * g⟫ = -⟪Dp Nx Δx * k, g⟫ := by
  rw [Frobenius.inner_mul_left, Dp_transpose, Matrix.neg_mul, inner_neg_right, neg_neg]

end Grid

section Transport

variable {N Nx : ℕ} [NeZero Nx] {μ w : Fin (N + 1) → ℝ} {Δx : ℝ}

/-- The advection operator `𝓛 g = (A⁺ D⁻ + A⁻ D⁺) g` of (3.3), on `g ∈ ℝ^{N_x × N}` whose rows are
the `g_{j+1/2}`; see `transport_row`. -/
noncomputable def transport (μ w : Fin (N + 1) → ℝ) (Δx : ℝ) (g : Matrix (ZMod Nx) (Fin N) ℝ) :
    Matrix (ZMod Nx) (Fin N) ℝ :=
  Dm Nx Δx * g * plusA μ w + Dp Nx Δx * g * minusA μ w

/-- `(A⁺ D⁺ + A⁻ D⁻) g`, which is minus the adjoint of `𝓛`.  The last display of the proof of
Lemma 3.5 arrives at this operator, and (3.11) then misnames it `𝓛`. -/
noncomputable def downwind (μ w : Fin (N + 1) → ℝ) (Δx : ℝ) (g : Matrix (ZMod Nx) (Fin N) ℝ) :
    Matrix (ZMod Nx) (Fin N) ℝ :=
  Dp Nx Δx * g * plusA μ w + Dm Nx Δx * g * minusA μ w

/-- The rows of `transport` are the formula (3.3). -/
theorem transport_row (g : Matrix (ZMod Nx) (Fin N) ℝ) (j : ZMod Nx) :
    transport μ w Δx g j =
      plusA μ w *ᵥ (Dm Nx Δx * g) j + minusA μ w *ᵥ (Dp Nx Δx * g) j := by
  ext l
  have hp := fun i => congrFun (congrFun (plusA_transpose μ w) i) l
  have hm := fun i => congrFun (congrFun (minusA_transpose μ w) i) l
  simp only [Matrix.transpose_apply] at hp hm
  simp only [transport, Matrix.add_apply, Pi.add_apply, Matrix.mulVec, dotProduct]
  rw [Matrix.mul_apply, Matrix.mul_apply]
  congr 1 <;> exact Finset.sum_congr rfl fun i _ => by simp only [hp, hm, mul_comm]

private theorem inner_mul_sym {m n : Type*} [Fintype m] [Fintype n] {A : Matrix n n ℝ}
    (hA : Aᵀ = A) (G Y : Matrix m n ℝ) : ⟪G, Y * A⟫ = ⟪G * A, Y⟫ := by
  rw [Frobenius.inner_mul_right, hA]

/-- `𝓛` and `-downwind` are adjoint to each other. -/
theorem inner_transport (G δ : Matrix (ZMod Nx) (Fin N) ℝ) :
    ⟪G, transport μ w Δx δ⟫ = -⟪downwind μ w Δx G, δ⟫ := by
  rw [transport, downwind, inner_add_right, inner_add_left,
    inner_mul_sym (plusA_transpose μ w), inner_mul_sym (minusA_transpose μ w), sbp_Dm, sbp_Dp,
    ← Matrix.mul_assoc, ← Matrix.mul_assoc]
  ring

/-- **Lemma 3.5, (3.10)**, arXiv 2212.12012: `∑_j g_jᵀ 𝓛 g_j = (Δx/2) ∑_j (D⁺g_j)ᵀ |A| D⁺g_j`.
No Gauss quadrature is needed, only the symmetry of `A` and `|A|`. -/
theorem inner_transport_self (hΔx : Δx ≠ 0) (g : Matrix (ZMod Nx) (Fin N) ℝ) :
    ⟪g, transport μ w Δx g⟫ =
      Δx / 2 * ⟪Dp Nx Δx * g, Dp Nx Δx * g * absA μ w⟫ := by
  have hp : plusA μ w = (1 / 2 : ℝ) • (fluxA μ w + absA μ w) := by
    rw [← plusA_add_minusA, ← plusA_sub_minusA]
    ext i j
    simp only [Matrix.smul_apply, Matrix.add_apply, Matrix.sub_apply, smul_eq_mul]
    ring
  have hm : minusA μ w = (1 / 2 : ℝ) • (fluxA μ w - absA μ w) := by
    rw [← plusA_add_minusA, ← plusA_sub_minusA]
    ext i j
    simp only [Matrix.smul_apply, Matrix.add_apply, Matrix.sub_apply, smul_eq_mul]
    ring
  set A := fluxA μ w
  set B := absA μ w
  have hA : Aᵀ = A := fluxA_transpose μ w
  have h1 : ⟪g, Dp Nx Δx * g * A⟫ = -⟪g, Dm Nx Δx * g * A⟫ := by
    rw [inner_mul_sym hA, sbp_Dp, ← Matrix.mul_assoc, real_inner_comm]
  have h2 : ⟪g, Dp Nx Δx * g * B⟫ - ⟪g, Dm Nx Δx * g * B⟫ =
      -(Δx * ⟪Dp Nx Δx * g, Dp Nx Δx * g * B⟫) := by
    have h3 := Dp_sub_Dm hΔx (g * B)
    have h4 : ⟪g, Dp Nx Δx * (g * B)⟫ - ⟪g, Dm Nx Δx * (g * B)⟫ =
        Δx * ⟪g, Dm Nx Δx * (Dp Nx Δx * (g * B))⟫ := by
      rw [← inner_sub_right, h3, inner_smul_right]
    rw [sbp_Dm g (Dp Nx Δx * (g * B))] at h4
    simp only [Matrix.mul_assoc]
    rw [h4]
    ring
  rw [transport, hp, hm, inner_add_right, Matrix.mul_smul, Matrix.mul_smul, inner_smul_right,
    inner_smul_right, Matrix.mul_add, Matrix.mul_sub, inner_add_right, inner_sub_right, h1]
  linear_combination (-1 / 2 : ℝ) * h2

theorem inner_mul_T_diag (Z : Matrix (ZMod Nx) (Fin N) ℝ) (d : Fin (N + 1) → ℝ) :
    ⟪Z, Z * (T μ w * Matrix.diagonal d * (T μ w)ᵀ)⟫ =
      ∑ j, ∑ k, d k * (Z * T μ w) j k ^ 2 := by
  have h : Z * (T μ w * Matrix.diagonal d * (T μ w)ᵀ) =
      (Z * T μ w * Matrix.diagonal d) * (T μ w)ᵀ := by
    simp only [Matrix.mul_assoc]
  rw [h, ← Frobenius.inner_mul_right, Frobenius.inner_def]
  refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun k _ => ?_
  rw [Matrix.mul_diagonal]
  ring

/-- **Lemma 3.5, nonnegativity in (3.10)**, arXiv 2212.12012: `∑_j g_jᵀ 𝓛 g_j ≥ 0` for `Δx > 0`.
The sum of squares is the `P_N` form `∑ |μ_k| (Tᵀ D⁺ g_j)_k²`. -/
theorem inner_transport_self_nonneg (hΔx : 0 < Δx) (g : Matrix (ZMod Nx) (Fin N) ℝ) :
    0 ≤ ⟪g, transport μ w Δx g⟫ := by
  rw [inner_transport_self hΔx.ne', absA, absM, inner_mul_T_diag]
  have : 0 ≤ ∑ j, ∑ k, |μ k| * (Dp Nx Δx * g * T μ w) j k ^ 2 :=
    Finset.sum_nonneg fun j _ => Finset.sum_nonneg fun k _ => by positivity
  positivity

/-- **Lemma 3.5, (3.11), corrected**, arXiv 2212.12012:
`∑_j (gⁿ⁺¹)ᵀ 𝓛 gⁿ = (Δx/2) ∑_j (D⁺gⁿ⁺¹)ᵀ |A| D⁺gⁿ⁺¹ + ∑_j (gⁿ⁺¹ - gⁿ)ᵀ (A⁺D⁺ + A⁻D⁻) gⁿ⁺¹`.
The paper writes `𝓛 gⁿ⁺¹` in the last term; that printed version is false, see
`lemma_3_5_printed_false`, and the printed proof does derive the operator used here. -/
theorem inner_transport_step (hΔx : Δx ≠ 0) (G H : Matrix (ZMod Nx) (Fin N) ℝ) :
    ⟪G, transport μ w Δx H⟫ =
      Δx / 2 * ⟪Dp Nx Δx * G, Dp Nx Δx * G * absA μ w⟫ + ⟪G - H, downwind μ w Δx G⟫ := by
  have h : transport μ w Δx H = transport μ w Δx G - transport μ w Δx (G - H) := by
    simp only [transport, Matrix.mul_sub, Matrix.sub_mul]
    abel
  rw [h, inner_sub_right, inner_transport_self hΔx, inner_transport,
    real_inner_comm (G - H) (downwind μ w Δx G)]
  ring

namespace IsGaussRule

variable (hG : IsGaussRule N μ w)
include hG

theorem norm_mul_T (Z : Matrix (ZMod Nx) (Fin N) ℝ) : ‖Z * T μ w‖ = ‖Z‖ := by
  have h : ((T μ w)ᵀ)ᵀ * (T μ w)ᵀ = 1 := by rw [Matrix.transpose_transpose, hG.T_mul_transpose]
  simpa using Frobenius.norm_mul_transpose_of_orthonormal h Z

theorem norm_mul_transpose_T_le (Y : Matrix (ZMod Nx) (Fin (N + 1)) ℝ) :
    ‖Y * (T μ w)ᵀ‖ ≤ ‖Y‖ := by
  have h5 : ⟪Y, Y * T₀ μ w * (T₀ μ w)ᵀ⟫ = ‖Y * T₀ μ w‖ ^ 2 := by
    rw [← Frobenius.inner_mul_right, real_inner_self_eq_norm_sq]
  have h : ‖Y * (T μ w)ᵀ‖ ^ 2 = ‖Y‖ ^ 2 - ‖Y * T₀ μ w‖ ^ 2 := by
    rw [← real_inner_self_eq_norm_sq (Y * (T μ w)ᵀ), Frobenius.inner_mul_right,
      Matrix.transpose_transpose, Matrix.mul_assoc, hG.transpose_mul_T, Matrix.mul_sub,
      Matrix.mul_one, inner_sub_right, real_inner_self_eq_norm_sq, ← Matrix.mul_assoc, h5]
  have h2 : ‖Y * (T μ w)ᵀ‖ ^ 2 ≤ ‖Y‖ ^ 2 := by
    rw [h]
    linarith [sq_nonneg ‖Y * T₀ μ w‖]
  exact (sq_le_sq₀ (norm_nonneg _) (norm_nonneg _)).1 h2

/-- `‖Z A⁺‖² + ‖Z A⁻‖² ≤ ∑_{j,k} μ_k² (Z T)_{jk}²`. -/
theorem norm_plus_minus_le (Z : Matrix (ZMod Nx) (Fin N) ℝ) :
    ‖Z * plusA μ w‖ ^ 2 + ‖Z * minusA μ w‖ ^ 2 ≤ ∑ j, ∑ k, μ k ^ 2 * (Z * T μ w) j k ^ 2 := by
  set Y := Z * T μ w with hY
  set Yp := Y * Matrix.diagonal (fun k => (μ k + |μ k|) / 2) with hYp
  set Ym := Y * Matrix.diagonal (fun k => (μ k - |μ k|) / 2) with hYm
  have hp : Z * plusA μ w = Yp * (T μ w)ᵀ := by
    have h1 : nodeM μ + absM μ = (2 : ℝ) • Matrix.diagonal (fun k => (μ k + |μ k|) / 2) := by
      ext i j
      by_cases h : i = j
      · subst h
        simp [nodeM, absM]
        ring
      · simp [nodeM, absM, h]
    simp only [plusA, h1, Matrix.mul_smul, Matrix.smul_mul, smul_smul, hYp, hY, Matrix.mul_assoc]
    norm_num
  have hm : Z * minusA μ w = Ym * (T μ w)ᵀ := by
    have h1 : nodeM μ - absM μ = (2 : ℝ) • Matrix.diagonal (fun k => (μ k - |μ k|) / 2) := by
      ext i j
      by_cases h : i = j
      · subst h
        simp [nodeM, absM]
        ring
      · simp [nodeM, absM, h]
    simp only [minusA, h1, Matrix.mul_smul, Matrix.smul_mul, smul_smul, hYm, hY, Matrix.mul_assoc]
    norm_num
  have h1 : ‖Yp‖ ^ 2 + ‖Ym‖ ^ 2 = ∑ j, ∑ k, μ k ^ 2 * Y j k ^ 2 := by
    rw [Frobenius.norm_sq_eq_sum, Frobenius.norm_sq_eq_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun k _ => ?_
    simp only [hYp, hYm, Matrix.mul_diagonal]
    have h2 : |μ k| ^ 2 = μ k ^ 2 := sq_abs _
    linear_combination (Y j k ^ 2 / 2) * h2
  rw [hp, hm, ← h1]
  have h3 := hG.norm_mul_transpose_T_le Yp
  have h4 := hG.norm_mul_transpose_T_le Ym
  gcongr

/-- `‖Z a‖² ≤ ((N + 1) / 2) ∑_{j,k} w_k μ_k² (Z T)_{jk}²`: the Young step of the proof of
Theorem 3.2. -/
theorem norm_mul_aVec_sq_le (Z : Matrix (ZMod Nx) (Fin N) ℝ) :
    ‖Z * aVec N‖ ^ 2 ≤ ((N : ℝ) + 1) / 2 * ∑ j, ∑ k, w k * μ k ^ 2 * (Z * T μ w) j k ^ 2 := by
  set Y := Z * T μ w with hY
  have h1 : Z * aVec N = Y * nodeM μ * T₀ μ w := by
    rw [← hG.T_mul_nodeM_mul_T₀, hY]
    simp only [Matrix.mul_assoc]
  rw [h1, Frobenius.norm_sq_eq_sum, Finset.mul_sum]
  refine Finset.sum_le_sum fun j _ => ?_
  simp only [Finset.univ_unique, Finset.sum_singleton]
  have h2 : (Y * nodeM μ * T₀ μ w) j default = ∑ k, Y j k * μ k * T₀ μ w k default := by
    rw [nodeM, Matrix.mul_apply]
    simp only [Matrix.mul_diagonal]
  rw [h2]
  have h3 := sq_sum_le_card_mul_sum_sq (s := Finset.univ)
    (f := fun k => Y j k * μ k * T₀ μ w k default)
  have h4 : ∀ k, (Y j k * μ k * T₀ μ w k default) ^ 2 = w k * μ k ^ 2 * Y j k ^ 2 / 2 := by
    intro k
    rw [mul_pow, mul_pow, hG.T₀_sq]
    ring
  simp only [h4, Finset.card_univ, Fintype.card_fin, Nat.cast_add, Nat.cast_one] at h3
  refine h3.trans_eq ?_
  rw [← Finset.sum_div]
  ring

/-- `‖(A⁺ D⁺ + A⁻ D⁻) G‖² ≤ 2 ∑_{j,k} μ_k² (D⁺G T)_{jk}²`. -/
theorem norm_downwind_sq_le (G : Matrix (ZMod Nx) (Fin N) ℝ) :
    ‖downwind μ w Δx G‖ ^ 2 ≤ 2 * ∑ j, ∑ k, μ k ^ 2 * (Dp Nx Δx * G * T μ w) j k ^ 2 := by
  have h1 : ‖Dm Nx Δx * G * minusA μ w‖ = ‖Dp Nx Δx * G * minusA μ w‖ := by
    rw [Matrix.mul_assoc, Matrix.mul_assoc, norm_Dm_mul]
  have h2 := hG.norm_plus_minus_le (Dp Nx Δx * G)
  have h3 := norm_add_le (Dp Nx Δx * G * plusA μ w) (Dm Nx Δx * G * minusA μ w)
  rw [h1] at h3
  have h4 : ‖downwind μ w Δx G‖ ^ 2 ≤
      (‖Dp Nx Δx * G * plusA μ w‖ + ‖Dp Nx Δx * G * minusA μ w‖) ^ 2 := by
    rw [downwind]
    gcongr
  nlinarith [sq_nonneg (‖Dp Nx Δx * G * plusA μ w‖ - ‖Dp Nx Δx * G * minusA μ w‖)]

/-- `‖(A⁺ D⁻ + A⁻ D⁺) G‖² ≤ 2 ∑_{j,k} μ_k² (D⁺G T)_{jk}²`. -/
theorem norm_transport_sq_le (G : Matrix (ZMod Nx) (Fin N) ℝ) :
    ‖transport μ w Δx G‖ ^ 2 ≤ 2 * ∑ j, ∑ k, μ k ^ 2 * (Dp Nx Δx * G * T μ w) j k ^ 2 := by
  have h1 : ‖Dm Nx Δx * G * plusA μ w‖ = ‖Dp Nx Δx * G * plusA μ w‖ := by
    rw [Matrix.mul_assoc, Matrix.mul_assoc, norm_Dm_mul]
  have h2 := hG.norm_plus_minus_le (Dp Nx Δx * G)
  have h3 := norm_add_le (Dm Nx Δx * G * plusA μ w) (Dp Nx Δx * G * minusA μ w)
  rw [h1] at h3
  have h4 : ‖transport μ w Δx G‖ ^ 2 ≤
      (‖Dp Nx Δx * G * plusA μ w‖ + ‖Dp Nx Δx * G * minusA μ w‖) ^ 2 := by
    rw [transport]
    gcongr
  nlinarith [sq_nonneg (‖Dp Nx Δx * G * plusA μ w‖ - ‖Dp Nx Δx * G * minusA μ w‖)]

end IsGaussRule

end Transport

section Energy

variable {N Nx : ℕ} [NeZero Nx] {μ w : Fin (N + 1) → ℝ} {Δx Δt ε σ₀ : ℝ} {σ : ZMod Nx → ℝ}

/-- The discrete `L²` norm (3.6): `∑_j |g_j|² Δx`, for `ρ` (one column) and `g`. -/
noncomputable def l2Sq {n : Type*} [Fintype n] (Δx : ℝ) (g : Matrix (ZMod Nx) n ℝ) : ℝ :=
  ∑ j, (∑ l, g j l ^ 2) * Δx

/-- The energy `eⁿ = ‖ρⁿ‖² + ε² ‖gⁿ‖²` of §3. -/
noncomputable def energy {n : Type*} [Fintype n] (Δx ε : ℝ) (ρ : Matrix (ZMod Nx) Unit ℝ)
    (g : Matrix (ZMod Nx) n ℝ) : ℝ :=
  l2Sq Δx ρ + ε ^ 2 * l2Sq Δx g

theorem l2Sq_eq {n : Type*} [Fintype n] (g : Matrix (ZMod Nx) n ℝ) :
    l2Sq Δx g = Δx * ‖g‖ ^ 2 := by
  rw [l2Sq, ← Finset.sum_mul, ← Frobenius.norm_sq_eq_sum, mul_comm]

theorem energy_eq {n : Type*} [Fintype n] (ρ : Matrix (ZMod Nx) Unit ℝ)
    (g : Matrix (ZMod Nx) n ℝ) : energy Δx ε ρ g = Δx * (‖ρ‖ ^ 2 + ε ^ 2 * ‖g‖ ^ 2) := by
  rw [energy, l2Sq_eq, l2Sq_eq]
  ring

private theorem polar {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] (x y : E) :
    ‖x‖ ^ 2 - ‖y‖ ^ 2 + ‖x - y‖ ^ 2 = 2 * ⟪x, x - y⟫ := by
  rw [norm_sub_sq_real, inner_sub_right, real_inner_self_eq_norm_sq]
  ring

private theorem young {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] (x y : E)
    (a b : ℝ) : -(2 * a * b * ⟪x, y⟫) ≤ a ^ 2 * ‖x‖ ^ 2 + b ^ 2 * ‖y‖ ^ 2 := by
  have h := norm_add_sq_real (a • x) (b • y)
  rw [norm_smul, norm_smul, inner_smul_left, inner_smul_right] at h
  simp only [Real.norm_eq_abs, mul_pow, sq_abs, conj_trivial] at h
  nlinarith [sq_nonneg ‖a • x + b • y‖]

private theorem sum_weight {n : Type*} [Fintype n] (f : n → ℝ) (Y : Matrix (ZMod Nx) n ℝ) :
    ∑ j, ∑ k, f k * Y j k ^ 2 = ∑ k, f k * ∑ j, Y j k ^ 2 := by
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun k _ => (Finset.mul_sum _ _ _).symm

theorem le_inner_diagonal (hσ : ∀ j, σ₀ ≤ σ j) {n : Type*} [Fintype n]
    (G : Matrix (ZMod Nx) n ℝ) : σ₀ * ‖G‖ ^ 2 ≤ ⟪G, Matrix.diagonal σ * G⟫ := by
  rw [Frobenius.norm_sq_eq_sum, Frobenius.inner_def, Finset.mul_sum]
  refine Finset.sum_le_sum fun j _ => ?_
  rw [Finset.mul_sum]
  refine Finset.sum_le_sum fun l _ => ?_
  rw [Matrix.diagonal_mul]
  nlinarith [mul_le_mul_of_nonneg_right (hσ j) (sq_nonneg (G j l))]

/-- The discrete energy method of Theorem 3.2, common to the full scheme and to the `S`-step of the
low-rank scheme.  `H` is the old micro variable, `G` the new one: all that is used of the micro
equation is its pairing with `G`, and of the macro equation `ρ₁ = ρ - Δt D⁻ (G a)`.  The CFL
condition is the one at the end of the proof of Theorem 3.2. -/
theorem energy_core (hG : IsGaussRule N μ w) (hΔx : 0 < Δx) (hΔt : 0 < Δt) (hε : 0 < ε)
    (hσ₀ : 0 < σ₀) (hσ : ∀ j, σ₀ ≤ σ j)
    (hcfl : ∀ k, Δt * ((2 + ((N : ℝ) + 1) * w k) * μ k ^ 2) ≤
      ε * Δx * |μ k| + σ₀ * Δx ^ 2 / 2)
    {ρ ρ₁ : Matrix (ZMod Nx) Unit ℝ} {G H : Matrix (ZMod Nx) (Fin N) ℝ}
    (hmacro : ρ₁ = ρ - Δt • (Dm Nx Δx * (G * aVec N)))
    (hmicro : ⟪G, (G - H) + (Δt / ε) • transport μ w Δx H +
      (Δt / ε ^ 2) • (Dp Nx Δx * ρ * (aVec N)ᵀ + Matrix.diagonal σ * G)⟫ = 0) :
    ‖ρ₁‖ ^ 2 + ε ^ 2 * ‖G‖ ^ 2 ≤ ‖ρ‖ ^ 2 + ε ^ 2 * ‖H‖ ^ 2 := by
  set u := Dm Nx Δx * (G * aVec N) with hu
  set δ := G - H with hδ
  set δρ := ρ₁ - ρ with hδρ
  have hδρ' : δρ = -(Δt • u) := by rw [hδρ, hmacro]; abel
  -- the pairings
  have e1 := polar ρ₁ ρ
  have e2 := polar G H
  rw [← hδρ] at e1
  rw [← hδ] at e2
  have e3 : ⟪ρ₁, δρ⟫ = -(Δt * ⟪ρ₁, u⟫) := by
    rw [hδρ', inner_neg_right, inner_smul_right]
  have e4 : ⟪G, Dp Nx Δx * ρ * (aVec N)ᵀ⟫ = -⟪ρ, u⟫ := by
    rw [← Frobenius.inner_mul_right, hu, real_inner_comm, sbp_Dm, neg_neg]
  have e5 : ⟪δρ, u⟫ = ⟪ρ₁, u⟫ - ⟪ρ, u⟫ := by rw [hδρ, inner_sub_left]
  have e6 := inner_transport_step (μ := μ) (w := w) hΔx.ne' G H
  rw [← hδ] at e6
  have hmicro' : ε ^ 2 * ⟪G, δ⟫ + ε * Δt * ⟪G, transport μ w Δx H⟫ +
      Δt * (⟪G, Dp Nx Δx * ρ * (aVec N)ᵀ⟫ + ⟪G, Matrix.diagonal σ * G⟫) = 0 := by
    rw [inner_add_right, inner_add_right, inner_smul_right, inner_smul_right, inner_add_right]
      at hmicro
    have h := congrArg (fun x => ε ^ 2 * x) hmicro
    simp only [mul_zero] at h
    rw [← h]
    field_simp
  set D := ⟪Dp Nx Δx * G, Dp Nx Δx * G * absA μ w⟫ with hD
  -- Young
  have y1 := young δρ u 1 Δt
  have y2 := young δ (downwind μ w Δx G) ε Δt
  -- coordinates
  set Y := Dp Nx Δx * G * T μ w with hY
  set Ĝ := G * T μ w with hĜ
  set P : Fin (N + 1) → ℝ := fun k => ∑ j, Y j k ^ 2 with hP
  set Q : Fin (N + 1) → ℝ := fun k => ∑ j, Ĝ j k ^ 2 with hQ
  have hP0 : ∀ k, 0 ≤ P k := fun k => Finset.sum_nonneg fun j _ => sq_nonneg _
  have hQ0 : ∀ k, 0 ≤ Q k := fun k => Finset.sum_nonneg fun j _ => sq_nonneg _
  have hPQ : ∀ k, P k ≤ 4 / Δx ^ 2 * Q k := by
    intro k
    have h := sum_Dp_sq_le (Nx := Nx) (Δx := Δx) Ĝ k
    have h2 : Dp Nx Δx * Ĝ = Y := by rw [hĜ, hY, Matrix.mul_assoc]
    rwa [h2] at h
  have hGQ : ‖G‖ ^ 2 = ∑ k, Q k := by
    rw [← hG.norm_mul_T G, Frobenius.norm_sq_eq_sum, Finset.sum_comm]
  have hDP : D = ∑ k, |μ k| * P k := by
    rw [hD, absA, absM, inner_mul_T_diag]
    exact sum_weight _ _
  have hU : ‖u‖ ^ 2 ≤ ((N : ℝ) + 1) / 2 * ∑ k, w k * μ k ^ 2 * P k := by
    have h1 : ‖u‖ = ‖Dp Nx Δx * G * aVec N‖ := by
      rw [hu, norm_Dm_mul, Matrix.mul_assoc]
    rw [h1]
    refine (hG.norm_mul_aVec_sq_le _).trans_eq ?_
    rw [sum_weight (fun k => w k * μ k ^ 2) _]
  have hW : ‖downwind μ w Δx G‖ ^ 2 ≤ 2 * ∑ k, μ k ^ 2 * P k := by
    refine (hG.norm_downwind_sq_le G).trans_eq ?_
    rw [sum_weight (fun k => μ k ^ 2) _]
  have hσG := le_inner_diagonal hσ G
  -- the nodewise inequality
  have hk : ∀ k, Δt * (((N : ℝ) + 1) / 2 * (w k * μ k ^ 2 * P k) + 2 * (μ k ^ 2 * P k)) -
      ε * Δx * (|μ k| * P k) - 2 * σ₀ * Q k ≤ 0 := by
    intro k
    have hc := hcfl k
    have hwpos := (hG.weight_pos k).le
    have hp := hP0 k
    have hq := hQ0 k
    have h1 : 0 ≤ Δt * (((N : ℝ) + 1) / 2 * (w k * μ k ^ 2 * P k)) := by positivity
    set c := Δt * ((2 + ((N : ℝ) + 1) * w k) * μ k ^ 2) - ε * Δx * |μ k| with hcdef
    have h2 : Δt * (((N : ℝ) + 1) / 2 * (w k * μ k ^ 2 * P k) + 2 * (μ k ^ 2 * P k)) -
        ε * Δx * (|μ k| * P k) ≤ c * P k := by
      rw [hcdef]
      nlinarith
    have h3 : c ≤ σ₀ * Δx ^ 2 / 2 := by rw [hcdef]; linarith
    have h4 : c * P k ≤ 2 * σ₀ * Q k := by
      calc c * P k ≤ σ₀ * Δx ^ 2 / 2 * P k := by gcongr
        _ ≤ σ₀ * Δx ^ 2 / 2 * (4 / Δx ^ 2 * Q k) := by gcongr; exact hPQ k
        _ = 2 * σ₀ * Q k := by field_simp; ring
    linarith
  have hsum : Δt * (((N : ℝ) + 1) / 2 * ∑ k, w k * μ k ^ 2 * P k + 2 * ∑ k, μ k ^ 2 * P k) -
      ε * Δx * D - 2 * σ₀ * ‖G‖ ^ 2 ≤ 0 := by
    have h := Finset.sum_nonpos fun k (_ : k ∈ Finset.univ) => hk k
    simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.mul_sum] at h
    rw [hDP, hGQ]
    linarith
  -- assembly
  have hkey : ‖ρ₁‖ ^ 2 + ε ^ 2 * ‖G‖ ^ 2 - (‖ρ‖ ^ 2 + ε ^ 2 * ‖H‖ ^ 2) ≤
      Δt ^ 2 * ‖u‖ ^ 2 + Δt ^ 2 * ‖downwind μ w Δx G‖ ^ 2 - ε * Δt * Δx * D -
        2 * Δt * ⟪G, Matrix.diagonal σ * G⟫ := by
    have hid : ‖ρ₁‖ ^ 2 + ε ^ 2 * ‖G‖ ^ 2 - (‖ρ‖ ^ 2 + ε ^ 2 * ‖H‖ ^ 2) + ‖δρ‖ ^ 2 +
        ε ^ 2 * ‖δ‖ ^ 2 =
        -(2 * Δt * ⟪δρ, u⟫) - ε * Δt * Δx * D - 2 * (ε * Δt * ⟪δ, downwind μ w Δx G⟫) -
          2 * Δt * ⟪G, Matrix.diagonal σ * G⟫ := by
      rw [e4] at hmicro'
      rw [e6] at hmicro'
      rw [e5]
      linear_combination e1 + ε ^ 2 * e2 + 2 * e3 + 2 * hmicro'
    simp only [one_pow, one_mul, mul_one] at y1
    linarith
  have hΔt2 : 0 ≤ Δt ^ 2 := sq_nonneg _
  have hf : Δt ^ 2 * ‖u‖ ^ 2 + Δt ^ 2 * ‖downwind μ w Δx G‖ ^ 2 ≤
      Δt ^ 2 * (((N : ℝ) + 1) / 2 * ∑ k, w k * μ k ^ 2 * P k + 2 * ∑ k, μ k ^ 2 * P k) := by
    rw [mul_add]
    gcongr
  have hg : Δt * (Δt * (((N : ℝ) + 1) / 2 * ∑ k, w k * μ k ^ 2 * P k +
      2 * ∑ k, μ k ^ 2 * P k) - ε * Δx * D - 2 * σ₀ * ‖G‖ ^ 2) ≤ 0 :=
    mul_nonpos_of_nonneg_of_nonpos hΔt.le hsum
  have hσ2 := mul_le_mul_of_nonneg_left hσG (by positivity : 0 ≤ 2 * Δt)
  linarith

end Energy

section Nodes

private noncomputable def phi (l : ℕ) : ℝ := √(2 * (l : ℝ) + 1)

private theorem phi_pos (l : ℕ) : 0 < phi l := Real.sqrt_pos.2 (by positivity)

private theorem phi_sq (l : ℕ) : phi l ^ 2 = 2 * (l : ℝ) + 1 := Real.sq_sqrt (by positivity)

private theorem coef_eq (l : ℕ) : coef l = ((l : ℝ) + 1) / (phi l * phi (l + 1)) := by
  have h : (2 * ((l + 1 : ℕ) : ℝ) + 1) = 2 * (l : ℝ) + 3 := by push_cast; ring
  rw [coef, phi, phi, h, Real.sqrt_mul (by positivity)]

private theorem coef_mul_phi_succ (l : ℕ) : coef l * phi (l + 1) = ((l : ℝ) + 1) / phi l := by
  have h1 := (phi_pos l).ne'
  have h2 := (phi_pos (l + 1)).ne'
  rw [coef_eq]
  field_simp

private theorem coef_mul_phi (l : ℕ) : coef l * phi l = ((l : ℝ) + 1) / phi (l + 1) := by
  have h1 := (phi_pos l).ne'
  have h2 := (phi_pos (l + 1)).ne'
  rw [coef_eq]
  field_simp

/-- The Legendre values at `1` give a positive eigenvector of the infinite Jacobi matrix. -/
private theorem coef_phi (l : ℕ) :
    coef l * phi (l + 1) + (if _ : l = 0 then 0 else coef (l - 1) * phi (l - 1)) = phi l := by
  rcases l with _ | l
  · simp only [dite_true, add_zero, coef_mul_phi_succ]
    have h : phi 0 = 1 := by simp [phi]
    simp [h]
  · simp only [Nat.add_eq_zero_iff, one_ne_zero, and_false, dite_false, Nat.add_sub_cancel]
    rw [coef_mul_phi_succ, coef_mul_phi]
    have h1 := (phi_pos (l + 1)).ne'
    have h2 := phi_sq (l + 1)
    push_cast at h2 ⊢
    field_simp
    linear_combination -h2

/-- The roots of `p_{N+1}` lie in `[-1, 1]`, by a Perron-Schur test against `√(2 l + 1)`. -/
theorem abs_le_one_of_legendre_eq_zero {N : ℕ} {x : ℝ} (hx : legendre (N + 1) x = 0) :
    |x| ≤ 1 := by
  set r : ℕ → ℝ := fun l => |legendre l x| / phi l with hr
  obtain ⟨l, hl, hmax⟩ := Finset.exists_max_image (Finset.range (N + 1)) r
    ⟨0, Finset.mem_range.2 (Nat.succ_pos N)⟩
  have hp0 : 0 < |legendre 0 x| := by
    rw [legendre_zero, abs_pos]
    positivity
  have hr0 : 0 < r 0 := div_pos hp0 (phi_pos 0)
  have hrl : 0 < r l := hr0.trans_le (hmax 0 (Finset.mem_range.2 (Nat.succ_pos N)))
  set R := r l with hR
  have hpl : |legendre l x| = R * phi l := by
    rw [hR, hr]
    exact (div_mul_cancel₀ _ (phi_pos l).ne').symm
  have hle : ∀ i, i ≤ N → |legendre i x| ≤ R * phi i := by
    intro i hi
    have h := hmax i (Finset.mem_range.2 (by omega))
    exact (div_le_iff₀ (phi_pos i)).1 h
  have hup : |legendre (l + 1) x| ≤ R * phi (l + 1) := by
    by_cases h : l + 1 ≤ N
    · exact hle _ h
    · have h2 : l + 1 = N + 1 := by have := Finset.mem_range.1 hl; omega
      rw [h2, hx, abs_zero]
      exact (mul_pos hrl (phi_pos _)).le
  have hmain : |x| * |legendre l x| ≤ R * phi l := by
    rw [← abs_mul, mul_legendre, ← coef_phi l, mul_add]
    refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
    · rw [abs_mul, abs_of_pos (coef_pos l)]
      nlinarith [coef_pos l]
    · by_cases h : l = 0
      · simp [h]
      · simp only [h, dite_false]
        rw [abs_mul, abs_of_pos (coef_pos _)]
        have := hle (l - 1) (by have := Finset.mem_range.1 hl; omega)
        nlinarith [coef_pos (l - 1)]
  rw [← hpl] at hmain
  have hplpos : 0 < |legendre l x| := by
    rw [hpl]
    exact mul_pos hrl (phi_pos l)
  exact le_of_mul_le_mul_right (by linarith) hplpos

variable {N : ℕ} {μ w : Fin (N + 1) → ℝ}

theorem IsGaussRule.abs_le_one (hG : IsGaussRule N μ w) (k : Fin (N + 1)) : |μ k| ≤ 1 :=
  abs_le_one_of_legendre_eq_zero (hG.root k)

/-- The weights of the rule add up to `2`, so each is at most `2`. -/
theorem IsGaussRule.weight_le_two (hG : IsGaussRule N μ w) (k : Fin (N + 1)) : w k ≤ 2 := by
  have h := hG.orthonormal 0 0
  simp only [ite_true, Fin.val_zero, legendre_zero] at h
  have h2 : ∑ k, w k = 2 := by
    have hs : (1 / √2 : ℝ) * (1 / √2) = 1 / 2 := by
      rw [div_mul_div_comm, Real.mul_self_sqrt (by norm_num)]
      norm_num
    have h3 : ∀ k, w k * (1 / √2) * (1 / √2) = w k * (1 / 2) := fun k => by
      rw [mul_assoc, hs]
    simp only [h3, ← Finset.sum_mul] at h
    linarith
  rw [← h2]
  exact Finset.single_le_sum (fun i _ => (hG.weight_pos i).le) (Finset.mem_univ k)

end Nodes

section Stability

variable {N Nx : ℕ} [NeZero Nx] {μ w : Fin (N + 1) → ℝ} {Δx Δt ε σ₀ : ℝ} {σ : ZMod Nx → ℝ}

/-- One step of the modal micro-macro scheme (3.5) on the periodic grid: `a₀ D⁻ g₁` is written
`D⁻ (g a)`, which is the same as `a = a₀ e₁`. -/
structure IsFullStep (μ w : Fin (N + 1) → ℝ) (Δx Δt ε : ℝ) (σ : ZMod Nx → ℝ)
    (ρ ρ₁ : Matrix (ZMod Nx) Unit ℝ) (g g₁ : Matrix (ZMod Nx) (Fin N) ℝ) : Prop where
  macroEq : Δt⁻¹ • (ρ₁ - ρ) + Dm Nx Δx * (g₁ * aVec N) = 0
  microEq : Δt⁻¹ • (g₁ - g) + ε⁻¹ • transport μ w Δx g =
    -((ε ^ 2)⁻¹ • (Dp Nx Δx * ρ * (aVec N)ᵀ)) - (ε ^ 2)⁻¹ • (Matrix.diagonal σ * g₁)

/-- The scheme (3.5) is uniquely solvable step by step for `σ > 0`: `IsFullStep` is not vacuous. -/
theorem exists_isFullStep (hΔt : 0 < Δt) (hε : 0 < ε) (hσ : ∀ j, 0 < σ j)
    (ρ : Matrix (ZMod Nx) Unit ℝ) (g : Matrix (ZMod Nx) (Fin N) ℝ) :
    ∃ ρ₁ g₁, IsFullStep μ w Δx Δt ε σ ρ ρ₁ g g₁ := by
  set R := g - (Δt / ε) • transport μ w Δx g - (Δt / ε ^ 2) • (Dp Nx Δx * ρ * (aVec N)ᵀ) with hR
  set g₁ : Matrix (ZMod Nx) (Fin N) ℝ :=
    Matrix.of fun j l => R j l / (1 + Δt / ε ^ 2 * σ j) with hg₁
  have hg : ∀ j l, g₁ j l * (1 + Δt / ε ^ 2 * σ j) = R j l := by
    intro j l
    have h : 0 < 1 + Δt / ε ^ 2 * σ j := by have := hσ j; positivity
    simp only [hg₁, Matrix.of_apply]
    exact div_mul_cancel₀ _ h.ne'
  refine ⟨ρ - Δt • (Dm Nx Δx * (g₁ * aVec N)), g₁, ?_, ?_⟩
  · rw [sub_sub_cancel_left, smul_neg, smul_smul, inv_mul_cancel₀ hΔt.ne', one_smul,
      neg_add_cancel]
  · ext j l
    have h := hg j l
    simp only [hR, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul, Matrix.add_apply,
      Matrix.neg_apply, Matrix.diagonal_mul] at h ⊢
    field_simp
    field_simp at h
    linear_combination h

private theorem IsFullStep.eq_macro (hΔt : 0 < Δt) {ρ ρ₁ : Matrix (ZMod Nx) Unit ℝ}
    {g g₁ : Matrix (ZMod Nx) (Fin N) ℝ} (h : IsFullStep μ w Δx Δt ε σ ρ ρ₁ g g₁) :
    ρ₁ = ρ - Δt • (Dm Nx Δx * (g₁ * aVec N)) := by
  have h1 := congrArg (fun Z => Δt • Z) h.macroEq
  simp only [smul_add, smul_smul, mul_inv_cancel₀ hΔt.ne', one_smul, smul_zero] at h1
  ext j u
  have h2 := congrFun (congrFun h1 j) u
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul,
    Matrix.zero_apply] at h2 ⊢
  linarith

private theorem IsFullStep.eq_micro (hΔt : 0 < Δt) (hε : 0 < ε) {ρ ρ₁ : Matrix (ZMod Nx) Unit ℝ}
    {g g₁ : Matrix (ZMod Nx) (Fin N) ℝ} (h : IsFullStep μ w Δx Δt ε σ ρ ρ₁ g g₁) :
    (g₁ - g) + (Δt / ε) • transport μ w Δx g +
      (Δt / ε ^ 2) • (Dp Nx Δx * ρ * (aVec N)ᵀ + Matrix.diagonal σ * g₁) = 0 := by
  ext j l
  have h1 := congrFun (congrFun h.microEq j) l
  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul,
    Matrix.neg_apply, Matrix.zero_apply] at h1 ⊢
  have ht := hΔt.ne'
  have he := hε.ne'
  field_simp at h1 ⊢
  linear_combination h1

/-- **Theorem 3.2 (energy stability), arXiv 2212.12012, with the CFL condition of its proof.**
If `Δt (2 μ_k² + (N + 1) w_k μ_k²) ≤ ε Δx |μ_k| + ½ Δx² σ₀` for every node (the condition of the
proof, after "To ensure stability"), then the scheme (3.5) satisfies `eⁿ⁺¹ ≤ eⁿ`, where `eⁿ` uses
the norms (3.6).

Differences from the printed proof, whose conclusion stands: the grid is periodic, as its summations
by parts need; the printed Lemmas 3.4, 3.5 (3.11) and 3.6 are false as stated
(`lemma_3_4_printed_false`, `lemma_3_5_printed_false`, `lemma_3_6_printed_false`) and are replaced
by `lemma_3_4_sq`, `inner_transport_step`, `lemma_3_6`; and the last estimate of the printed proof,
which is only valid where the bracket is nonnegative, is made node by node. -/
theorem energy_stable_of_cfl (hG : IsGaussRule N μ w) (hΔx : 0 < Δx) (hΔt : 0 < Δt) (hε : 0 < ε)
    (hσ₀ : 0 < σ₀) (hσ : ∀ j, σ₀ ≤ σ j)
    (hcfl : ∀ k, Δt * ((2 + ((N : ℝ) + 1) * w k) * μ k ^ 2) ≤
      ε * Δx * |μ k| + σ₀ * Δx ^ 2 / 2)
    {ρ ρ₁ : Matrix (ZMod Nx) Unit ℝ} {g g₁ : Matrix (ZMod Nx) (Fin N) ℝ}
    (h : IsFullStep μ w Δx Δt ε σ ρ ρ₁ g g₁) : energy Δx ε ρ₁ g₁ ≤ energy Δx ε ρ g := by
  rw [energy_eq, energy_eq]
  have h1 := energy_core (ρ := ρ) (H := g) hG hΔx hΔt hε hσ₀ hσ hcfl (h.eq_macro hΔt)
    (by rw [h.eq_micro hΔt hε, inner_zero_right])
  exact mul_le_mul_of_nonneg_left h1 hΔx.le

/-- The step-size condition (3.7) with the explicit constant `C = 1 / (4 (N + 2))` implies the
nodewise condition of the proof of Theorem 3.2.  Here `|μ_k| ≤ 1` and `w_k ≤ 2` are proved. -/
theorem cfl_of_le (hG : IsGaussRule N μ w) (hΔx : 0 < Δx) (hΔt : 0 < Δt) (hε : 0 < ε)
    (hσ₀ : 0 < σ₀) (hcfl : Δt ≤ 1 / (4 * ((N : ℝ) + 2)) * (ε * Δx + σ₀ * Δx ^ 2))
    (k : Fin (N + 1)) :
    Δt * ((2 + ((N : ℝ) + 1) * w k) * μ k ^ 2) ≤ ε * Δx * |μ k| + σ₀ * Δx ^ 2 / 2 := by
  have hn : (0 : ℝ) < 4 * ((N : ℝ) + 2) := by positivity
  have h1 : Δt * (4 * ((N : ℝ) + 2)) ≤ ε * Δx + σ₀ * Δx ^ 2 := by
    rw [one_div, inv_mul_eq_div, le_div_iff₀ hn] at hcfl
    exact hcfl
  have hw := hG.weight_le_two k
  have hm := hG.abs_le_one k
  have hm0 := abs_nonneg (μ k)
  have hsq : μ k ^ 2 ≤ |μ k| := by
    rw [← sq_abs]
    nlinarith
  have hsq1 : μ k ^ 2 ≤ 1 := by
    rw [← sq_abs]
    nlinarith
  have hsq0 : 0 ≤ μ k ^ 2 := sq_nonneg _
  have hcoef : 2 + ((N : ℝ) + 1) * w k ≤ 2 * ((N : ℝ) + 2) := by
    have : ((N : ℝ) + 1) * w k ≤ ((N : ℝ) + 1) * 2 := by gcongr
    linarith
  have hE : 0 ≤ ε * Δx := by positivity
  have hE2 : 0 ≤ σ₀ * Δx ^ 2 := by positivity
  calc Δt * ((2 + ((N : ℝ) + 1) * w k) * μ k ^ 2)
      ≤ Δt * ((2 * ((N : ℝ) + 2)) * μ k ^ 2) := by gcongr
    _ = (Δt * (4 * ((N : ℝ) + 2))) * (μ k ^ 2 / 2) := by ring
    _ ≤ (ε * Δx + σ₀ * Δx ^ 2) * (μ k ^ 2 / 2) := by gcongr
    _ ≤ ε * Δx * |μ k| + σ₀ * Δx ^ 2 / 2 := by nlinarith

/-- **Theorem 3.2 (energy stability), arXiv 2212.12012.**  With `C = 1 / (4 (N + 2))`, the CFL
condition (3.7) `Δt ≤ C (ε Δx + σ₀ Δx²)` gives `eⁿ⁺¹ ≤ eⁿ` for the scheme (3.5) on a periodic grid.
The paper leaves `C` implicit.  This `C` depends on `N`; the paper's remark that `(N + 1) w_k`
remains bounded, which would remove that dependence, is not formalized. -/
theorem energy_stable (hG : IsGaussRule N μ w) (hΔx : 0 < Δx) (hΔt : 0 < Δt) (hε : 0 < ε)
    (hσ₀ : 0 < σ₀) (hσ : ∀ j, σ₀ ≤ σ j)
    (hcfl : Δt ≤ 1 / (4 * ((N : ℝ) + 2)) * (ε * Δx + σ₀ * Δx ^ 2))
    {ρ ρ₁ : Matrix (ZMod Nx) Unit ℝ} {g g₁ : Matrix (ZMod Nx) (Fin N) ℝ}
    (h : IsFullStep μ w Δx Δt ε σ ρ ρ₁ g g₁) : energy Δx ε ρ₁ g₁ ≤ energy Δx ε ρ g :=
  energy_stable_of_cfl hG hΔx hΔt hε hσ₀ hσ (cfl_of_le hG hΔx hΔt hε hσ₀ hcfl) h

end Stability

section PrintedLemmas

variable {N : ℕ} {μ w : Fin (N + 1) → ℝ}

/-- The vector `a_f = (0, a₀, 0, …, 0)ᵀ` of (3.9). -/
noncomputable def aFull (N : ℕ) : Matrix (Fin (N + 1)) Unit ℝ :=
  Matrix.of fun i _ => if (i : ℕ) = 1 then coef 0 else 0

/-- `ĥ = T_fᵀ h` for the extension `h = (0, g₁, …, g_N)` of `g`, as in Lemma 3.4. -/
noncomputable def hHat (μ w : Fin (N + 1) → ℝ) (g : Fin N → ℝ) : Fin (N + 1) → ℝ :=
  (Tf μ w)ᵀ *ᵥ (Fin.cons 0 g : Fin (N + 1) → ℝ)

theorem hHat_eq (g : Fin N → ℝ) : hHat μ w g = (T μ w)ᵀ *ᵥ g := by
  ext k
  simp only [hHat, Matrix.mulVec, dotProduct, Matrix.transpose_apply, Fin.sum_univ_succ,
    Fin.cons_zero, Fin.cons_succ, mul_zero, zero_add]
  exact Finset.sum_congr rfl fun i _ => by rw [IsGaussRule.T_eq]

private theorem quad_form (D : Matrix (Fin (N + 1)) (Fin (N + 1)) ℝ) (g : Fin N → ℝ) :
    g ⬝ᵥ ((T μ w * D * (T μ w)ᵀ) *ᵥ g) = hHat μ w g ⬝ᵥ (D *ᵥ hHat μ w g) := by
  rw [hHat_eq, ← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec,
    Matrix.mulVec_transpose]

private theorem quad_outer {k l : Type*} [Fintype k] [Fintype l] (B : Matrix k l ℝ) (g : k → ℝ) :
    g ⬝ᵥ ((B * Bᵀ) *ᵥ g) = (Bᵀ *ᵥ g) ⬝ᵥ (Bᵀ *ᵥ g) := by
  rw [← Matrix.mulVec_mulVec, Matrix.dotProduct_mulVec, Matrix.mulVec_transpose]

/-- **Lemma 3.4, second identity**, arXiv 2212.12012: `gᵀ |A| g = ĥᵀ |M| ĥ`. -/
theorem lemma_3_4_abs (g : Fin N → ℝ) :
    g ⬝ᵥ (absA μ w *ᵥ g) = hHat μ w g ⬝ᵥ (absM μ *ᵥ hHat μ w g) :=
  quad_form _ g

/-- **Lemma 3.4, third identity**, arXiv 2212.12012: `gᵀ a aᵀ g = ĥᵀ T_fᵀ a_f a_fᵀ T_f ĥ`. -/
theorem lemma_3_4_aa (hG : IsGaussRule N μ w) (g : Fin N → ℝ) :
    g ⬝ᵥ ((aVec N * (aVec N)ᵀ) *ᵥ g) =
      hHat μ w g ⬝ᵥ (((Tf μ w)ᵀ * aFull N * (aFull N)ᵀ * Tf μ w) *ᵥ hHat μ w g) := by
  set h : Fin (N + 1) → ℝ := Fin.cons 0 g with hh
  have h1 : (Tf μ w)ᵀ * aFull N * (aFull N)ᵀ * Tf μ w =
      ((Tf μ w)ᵀ * aFull N) * ((Tf μ w)ᵀ * aFull N)ᵀ := by
    simp only [Matrix.transpose_mul, Matrix.transpose_transpose, Matrix.mul_assoc]
  have h2 : ((Tf μ w)ᵀ * aFull N)ᵀ *ᵥ hHat μ w g = (aVec N)ᵀ *ᵥ g := by
    have h3 : Tf μ w *ᵥ hHat μ w g = h := by
      rw [hHat, Matrix.mulVec_mulVec, hG.Tf_mul_transpose, Matrix.one_mulVec]
    rw [Matrix.transpose_mul, Matrix.transpose_transpose, ← Matrix.mulVec_mulVec, h3]
    ext u
    simp only [Matrix.mulVec, dotProduct, Matrix.transpose_apply, Fin.sum_univ_succ, hh,
      Fin.cons_zero, Fin.cons_succ, mul_zero, zero_add]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [aFull, aVec]
  rw [h1, quad_outer, quad_outer, h2]

/-- **Lemma 3.4, first identity, corrected**, arXiv 2212.12012:
`gᵀ A² g + gᵀ a aᵀ g = ĥᵀ M² ĥ`.  The paper omits the second term: in its proof
`(A_f h)ᵀ (A_f h) = hᵀ a aᵀ h + gᵀ A² g` is followed by `= gᵀ A² g`, and `hᵀ a aᵀ h = (a₀ g₁)²` does
not vanish.  See `lemma_3_4_printed_false`. -/
theorem lemma_3_4_sq (hG : IsGaussRule N μ w) (g : Fin N → ℝ) :
    g ⬝ᵥ ((fluxA μ w * fluxA μ w) *ᵥ g) + g ⬝ᵥ ((aVec N * (aVec N)ᵀ) *ᵥ g) =
      hHat μ w g ⬝ᵥ ((nodeM μ * nodeM μ) *ᵥ hHat μ w g) := by
  rw [← quad_form, hG.T_sq_T, Matrix.add_mulVec, dotProduct_add]

/-- **Lemma 3.4, first identity, is false as printed**, arXiv 2212.12012: for every `N ≥ 1` there
is a `g` with `gᵀ A² g ≠ ĥᵀ M² ĥ`, namely `g = e₁`, for which the two sides differ by
`a₀² = 1/3`.  The correct identity is `lemma_3_4_sq`. -/
theorem lemma_3_4_printed_false (hG : IsGaussRule N μ w) (hN : 0 < N) :
    ∃ g : Fin N → ℝ, g ⬝ᵥ ((fluxA μ w * fluxA μ w) *ᵥ g) ≠
      hHat μ w g ⬝ᵥ ((nodeM μ * nodeM μ) *ᵥ hHat μ w g) := by
  set i₀ : Fin N := ⟨0, hN⟩ with hi₀
  refine ⟨Pi.single i₀ 1, fun h => ?_⟩
  have h1 := lemma_3_4_sq hG (Pi.single i₀ 1)
  rw [← h, quad_outer] at h1
  have h2 : (aVec N)ᵀ *ᵥ (Pi.single i₀ 1 : Fin N → ℝ) = fun _ => coef 0 := by
    ext u
    simp [Matrix.mulVec, dotProduct, aVec, hi₀, Pi.single_apply]
  rw [h2] at h1
  simp only [dotProduct, Finset.univ_unique, Finset.sum_singleton] at h1
  have h3 := (coef_pos 0).ne'
  have h4 : coef 0 * coef 0 = 0 := by linarith
  exact h3 (mul_self_eq_zero.1 h4)

/-- `|A|` has a positive first diagonal entry. -/
theorem IsGaussRule.absA_pos (hG : IsGaussRule N μ w) (i : Fin N) (hi : (i : ℕ) = 0) :
    0 < absA μ w i i := by
  have h1 : absA μ w i i = ∑ k, |μ k| * T μ w i k ^ 2 := by
    rw [absA, absM, Matrix.mul_apply]
    simp only [Matrix.mul_diagonal, Matrix.transpose_apply]
    exact Finset.sum_congr rfl fun k _ => by ring
  have h2 : ∑ k, T μ w i k ^ 2 = 1 := by
    have h := congrFun (congrFun hG.T_mul_transpose i) i
    simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.one_apply_eq] at h
    rw [← h]
    exact Finset.sum_congr rfl fun k _ => by ring
  obtain ⟨k, hk⟩ : ∃ k, T μ w i k ≠ 0 := by
    by_contra hc
    push Not at hc
    simp [hc] at h2
  have hm : μ k ≠ 0 := by
    intro h0
    apply hk
    simp [T, hi, legendre_one, h0]
  rw [h1]
  refine Finset.sum_pos' (fun k _ => by positivity) ⟨k, Finset.mem_univ k, ?_⟩
  have := abs_pos.2 hm
  positivity

section Example

variable {Δx : ℝ}

/-- The sawtooth `(1, -1)` on the two-cell periodic grid, for `P₁`. -/
private def gEx : Matrix (ZMod 2) (Fin 1) ℝ := Matrix.of fun j _ => if j = 0 then 1 else -1

private theorem zmod2 (j : ZMod 2) : j = 0 ∨ j = 1 := by
  revert j
  decide

private theorem gEx_succ (j : ZMod 2) (l : Fin 1) : gEx (j + 1) l = -gEx j l := by
  have h : (1 + 1 : ZMod 2) = 0 := by decide
  rcases zmod2 j with rfl | rfl <;> simp [gEx, h]

private theorem gEx_pred (j : ZMod 2) (l : Fin 1) : gEx (j - 1) l = -gEx j l := by
  have h : (0 - 1 : ZMod 2) = 1 := by decide
  rcases zmod2 j with rfl | rfl <;> simp [gEx, h]

private theorem transport_gEx {μ w : Fin (1 + 1) → ℝ} (hΔx : Δx ≠ 0) :
    transport μ w Δx gEx = (2 * absA μ w 0 0 / Δx) • gEx := by
  have h1 : absA μ w 0 0 = plusA μ w 0 0 - minusA μ w 0 0 := by
    rw [← plusA_sub_minusA, Matrix.sub_apply]
  ext j l
  obtain rfl : l = 0 := Subsingleton.elim _ _
  rw [transport, Matrix.add_apply, Matrix.mul_apply, Matrix.mul_apply]
  simp only [Finset.univ_unique, Finset.sum_singleton, Fin.default_eq_zero, Dp_mul_apply,
    Dm_mul_apply, gEx_succ, gEx_pred, Matrix.smul_apply, smul_eq_mul, h1]
  field_simp
  ring

private theorem gEx_ne : gEx ≠ 0 := by
  intro h
  have := congrFun (congrFun h 0) 0
  simp [gEx] at this

/-- **Lemma 3.5, (3.11), is false as printed**, arXiv 2212.12012: with `𝓛 gⁿ⁺¹` in the last term the
identity fails for `P₁` on two cells, already for `gⁿ = 0`.  The operator in the last term has to
be `A⁺ D⁺ + A⁻ D⁻`, which is what the proof of the lemma derives: see `inner_transport_step`. -/
theorem lemma_3_5_printed_false {μ w : Fin (1 + 1) → ℝ} (hG : IsGaussRule 1 μ w) (hΔx : 0 < Δx) :
    ∃ G H : Matrix (ZMod 2) (Fin 1) ℝ, ⟪G, transport μ w Δx H⟫ ≠
      Δx / 2 * ⟪Dp 2 Δx * G, Dp 2 Δx * G * absA μ w⟫ + ⟪G - H, transport μ w Δx G⟫ := by
  refine ⟨gEx, 0, fun h => ?_⟩
  have h0 : transport μ w Δx (0 : Matrix (ZMod 2) (Fin 1) ℝ) = 0 := by simp [transport]
  rw [h0, inner_zero_right, sub_zero, ← inner_transport_self hΔx.ne', transport_gEx hΔx.ne',
    inner_smul_right, real_inner_self_eq_norm_sq] at h
  have hc := hG.absA_pos 0 rfl
  have hn : 0 < ‖gEx‖ := norm_pos_iff.2 gEx_ne
  have : 0 < 2 * absA μ w 0 0 / Δx * ‖gEx‖ ^ 2 := by positivity
  linarith

/-- **Lemma 3.6 (boundedness), corrected**, arXiv 2212.12012:
`∑_j |𝓛 g_j|² ≤ 2 ∑_j (D⁺g_j)ᵀ (A² + a aᵀ) D⁺g_j`, and the same for `A⁺ D⁺ + A⁻ D⁻`, the operator
the proof of Theorem 3.2 actually needs.  `A² + a aᵀ = T M² Tᵀ` by `IsGaussRule.T_sq_T`.  The
printed statement has `A²` and is false, see `lemma_3_6_printed_false`.  Its proof also replaces
`(∑_k x_k)²` by `∑_k x_k²` in the Young step; the argument here avoids that step altogether. -/
theorem lemma_3_6 {Nx : ℕ} [NeZero Nx] (hG : IsGaussRule N μ w)
    (g : Matrix (ZMod Nx) (Fin N) ℝ) :
    ‖transport μ w Δx g‖ ^ 2 ≤
        2 * ⟪Dp Nx Δx * g, Dp Nx Δx * g * (fluxA μ w * fluxA μ w + aVec N * (aVec N)ᵀ)⟫ ∧
      ‖downwind μ w Δx g‖ ^ 2 ≤
        2 * ⟪Dp Nx Δx * g, Dp Nx Δx * g * (fluxA μ w * fluxA μ w + aVec N * (aVec N)ᵀ)⟫ := by
  have h : ⟪Dp Nx Δx * g, Dp Nx Δx * g * (fluxA μ w * fluxA μ w + aVec N * (aVec N)ᵀ)⟫ =
      ∑ j, ∑ k, μ k ^ 2 * (Dp Nx Δx * g * T μ w) j k ^ 2 := by
    rw [← hG.T_sq_T, nodeM, Matrix.diagonal_mul_diagonal, ← inner_mul_T_diag]
    simp only [sq]
  rw [h]
  exact ⟨hG.norm_transport_sq_le g, hG.norm_downwind_sq_le g⟩

/-- **Lemma 3.6 (boundedness) is false as printed**, arXiv 2212.12012: for `P₁` the flux matrix
vanishes, `A = 0`, so the printed bound `∑_j |𝓛 g_j|² ≤ 2 ∑_j (D⁺g_j)ᵀ A² D⁺g_j` would force
`𝓛 = 0`, but `𝓛 = |A| (D⁻ - D⁺) / 2` does not vanish.  See `lemma_3_6` for the correct bound. -/
theorem lemma_3_6_printed_false {μ w : Fin (1 + 1) → ℝ} (hG : IsGaussRule 1 μ w) (hΔx : 0 < Δx) :
    ∃ g : Matrix (ZMod 2) (Fin 1) ℝ, ¬ ‖transport μ w Δx g‖ ^ 2 ≤
      2 * ⟪Dp 2 Δx * g, Dp 2 Δx * g * (fluxA μ w * fluxA μ w)⟫ := by
  have hA : fluxA μ w = 0 := by
    ext i j
    rw [hG.fluxA_apply]
    obtain rfl : i = 0 := Subsingleton.elim _ _
    obtain rfl : j = 0 := Subsingleton.elim _ _
    simp
  refine ⟨gEx, fun h => ?_⟩
  rw [hA, Matrix.mul_zero, Matrix.mul_zero, inner_zero_right, mul_zero, transport_gEx hΔx.ne'] at h
  have hc := hG.absA_pos 0 rfl
  have hn : 0 < ‖(2 * absA μ w 0 0 / Δx) • gEx‖ := by
    refine norm_pos_iff.2 (smul_ne_zero (by positivity) gEx_ne)
  have : 0 < ‖(2 * absA μ w 0 0 / Δx) • gEx‖ ^ 2 := by positivity
  linarith

end Example

end PrintedLemmas

section DLRA

variable {N Nx : ℕ} [NeZero Nx] {μ w : Fin (N + 1) → ℝ} {Δx Δt ε σ₀ : ℝ} {σ : ZMod Nx → ℝ}
  {r p q : Type*} [Fintype r] [Fintype p] [Fintype q]

/-- The transport term of the library's `K`-step, for `𝒯 = transport`, is the operator
`𝓛_K K = D⁻K Vᵀ A⁺ V + D⁺K Vᵀ A⁻ V` of §5.1. -/
theorem transport_kStep (X : Matrix (ZMod Nx) r ℝ) (S : Matrix r r ℝ)
    (V : Matrix (Fin N) r ℝ) :
    transport μ w Δx (X * S * Vᵀ) * V =
      Dm Nx Δx * (X * S) * (Vᵀ * plusA μ w * V) + Dp Nx Δx * (X * S) * (Vᵀ * minusA μ w * V) := by
  simp only [transport, Matrix.add_mul, Matrix.mul_assoc]

/-- The transport term of the library's `L`-step, for `𝒯 = transport`, is the operator
`𝓛_L L = A⁺ L ∑_j D⁻X_j X_jᵀ + A⁻ L ∑_j D⁺X_j X_jᵀ` of §5.1, with `L = V Sᵀ`. -/
theorem transport_lStep (X : Matrix (ZMod Nx) r ℝ) (S : Matrix r r ℝ)
    (V : Matrix (Fin N) r ℝ) :
    (transport μ w Δx (X * S * Vᵀ))ᵀ * X =
      plusA μ w * (V * Sᵀ) * ((Dm Nx Δx * X)ᵀ * X) +
        minusA μ w * (V * Sᵀ) * ((Dp Nx Δx * X)ᵀ * X) := by
  simp only [transport, Matrix.transpose_add, Matrix.transpose_mul, Matrix.transpose_transpose,
    plusA_transpose, minusA_transpose, Matrix.add_mul, Matrix.mul_assoc]

/-- The transport term of the `S`-step, for `𝒯 = transport`, is the operator
`𝓛_S S = D̂⁻ S V₁ᵀ A⁺ V₁ + D̂⁺ S V₁ᵀ A⁻ V₁` of §5.1, with `D̂^± = ∑_j X₁ⱼ D^± X₁ⱼᵀ`. -/
theorem transport_sStep (X₁ : Matrix (ZMod Nx) p ℝ) (S : Matrix p q ℝ)
    (V₁ : Matrix (Fin N) q ℝ) :
    X₁ᵀ * transport μ w Δx (X₁ * S * V₁ᵀ) * V₁ =
      (X₁ᵀ * (Dm Nx Δx * X₁)) * S * (V₁ᵀ * plusA μ w * V₁) +
        (X₁ᵀ * (Dp Nx Δx * X₁)) * S * (V₁ᵀ * minusA μ w * V₁) := by
  simp only [transport, Matrix.add_mul, Matrix.mul_add, Matrix.mul_assoc]

private theorem inner_core (S : Matrix p q ℝ) (X₁ : Matrix (ZMod Nx) p ℝ)
    (V₁ : Matrix (Fin N) q ℝ) (Y : Matrix (ZMod Nx) (Fin N) ℝ) :
    ⟪S, X₁ᵀ * Y * V₁⟫ = ⟪X₁ * S * V₁ᵀ, Y⟫ := by
  rw [Matrix.mul_assoc X₁, Frobenius.inner_mul_left, Frobenius.inner_mul_right,
    Matrix.transpose_transpose]

variable [DecidableEq r] [DecidableEq p] [DecidableEq q]

/-- **Theorem 5.2 (energy stability of the DLRA scheme), arXiv 2212.12012, with the CFL condition
of the proof of Theorem 3.2.**  One step of the fully discrete fixed-rank BUG scheme of §5.2 is
`IsMicroMacroBUGStep` for `𝒯 = transport` and `d = D⁺ρⁿ` (see `transport_kStep`, `transport_lStep`,
`transport_sStep`; the library also allows augmented bases), together with the macro update (5.4).
Then `eⁿ⁺¹ ≤ eⁿ` for `gⁿ = Xⁿ Sⁿ Vⁿᵀ`, `gⁿ⁺¹ = Xⁿ⁺¹ Sⁿ⁺¹ Vⁿ⁺¹ᵀ`.  As in the paper, the `S`-step
tested with `gⁿ⁺¹` is (3.13) with `gⁿ` replaced by `g̃ⁿ = P_X gⁿ P_V`, which is why neither the
`K`- nor the `L`-step enters.  The printed proof stops at the energy of `g̃ⁿ`; the last step is
`‖g̃ⁿ‖ ≤ ‖gⁿ‖`. -/
theorem energy_stable_dlra_of_cfl (hG : IsGaussRule N μ w) (hΔx : 0 < Δx) (hΔt : 0 < Δt)
    (hε : 0 < ε) (hσ₀ : 0 < σ₀) (hσ : ∀ j, σ₀ ≤ σ j)
    (hcfl : ∀ k, Δt * ((2 + ((N : ℝ) + 1) * w k) * μ k ^ 2) ≤
      ε * Δx * |μ k| + σ₀ * Δx ^ 2 / 2)
    {ρ ρ₁ : Matrix (ZMod Nx) Unit ℝ} {X : Matrix (ZMod Nx) r ℝ} {S : Matrix r r ℝ}
    {V : Matrix (Fin N) r ℝ} {K₁ : Matrix (ZMod Nx) r ℝ} {L₁ : Matrix (Fin N) r ℝ}
    {X₁ : Matrix (ZMod Nx) p ℝ} {V₁ : Matrix (Fin N) q ℝ} {S₁ : Matrix p q ℝ}
    (h : IsMicroMacroBUGStep σ (transport μ w Δx) (Dp Nx Δx * ρ) (aVec N) Δt ε
      X S V K₁ L₁ X₁ V₁ S₁)
    (hρ : Δt⁻¹ • (ρ₁ - ρ) + Dm Nx Δx * (X₁ * S₁ * V₁ᵀ * aVec N) = 0) :
    energy Δx ε ρ₁ (X₁ * S₁ * V₁ᵀ) ≤ energy Δx ε ρ (X * S * Vᵀ) := by
  have hP := isOrthProj_galerkinProj (n := Fin N) h.hX₁ h.hV₁
  set G := X₁ * S₁ * V₁ᵀ with hG'
  set g₀ := X * S * Vᵀ with hg₀
  set H := X₁ * X₁ᵀ * g₀ * (V₁ * V₁ᵀ) with hH
  have hL := h.sLift
  rw [← hG', ← hg₀, ← hH] at hL
  set z := (H - (Δt / ε) • transport μ w Δx H) +
    (Δt / ε ^ 2) • (scatter σ G + -(Dp Nx Δx * ρ * (aVec N)ᵀ)) with hz
  have hGz : ⟪G, G - z⟫ = 0 := by
    have h1 : ⟪G, G⟫ = ⟪G, z⟫ := by
      calc ⟪G, G⟫ = ⟪galerkinProj X₁ V₁ z, G⟫ := by rw [← hL]
        _ = ⟪z, galerkinProj X₁ V₁ G⟫ := hP.symm _ _
        _ = ⟪z, G⟫ := by rw [hL, hP.idem]
        _ = ⟪G, z⟫ := real_inner_comm _ _
    rw [inner_sub_right, h1, sub_self]
  have hmicro : ⟪G, (G - H) + (Δt / ε) • transport μ w Δx H +
      (Δt / ε ^ 2) • (Dp Nx Δx * ρ * (aVec N)ᵀ + Matrix.diagonal σ * G)⟫ = 0 := by
    rw [← hGz, hz, scatter_apply]
    congr 1
    simp only [smul_add, smul_neg]
    abel
  have hmacro : ρ₁ = ρ - Δt • (Dm Nx Δx * (G * aVec N)) := by
    have h1 := congrArg (fun Z => Δt • Z) hρ
    simp only [smul_add, smul_smul, mul_inv_cancel₀ hΔt.ne', one_smul, smul_zero] at h1
    ext j u
    have h2 := congrFun (congrFun h1 j) u
    simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul,
      Matrix.zero_apply] at h2 ⊢
    linarith
  have h1 := energy_core hG hΔx hΔt hε hσ₀ hσ hcfl hmacro hmicro
  have h2 : ‖H‖ ≤ ‖g₀‖ := by
    have := hP.norm_le g₀
    rwa [galerkinProj_apply] at this
  have h3 : ε ^ 2 * ‖H‖ ^ 2 ≤ ε ^ 2 * ‖g₀‖ ^ 2 := by gcongr
  rw [energy_eq, energy_eq]
  exact mul_le_mul_of_nonneg_left (h1.trans (by linarith)) hΔx.le

/-- **Theorem 5.2 (energy stability of the DLRA scheme), arXiv 2212.12012.**  Under the CFL
condition (3.7), with the constant `C = 1 / (4 (N + 2))` of `energy_stable`, the fully discrete
fixed-rank BUG scheme of §5.2 satisfies `eⁿ⁺¹ ≤ eⁿ`.  See `energy_stable_dlra_of_cfl`. -/
theorem energy_stable_dlra (hG : IsGaussRule N μ w) (hΔx : 0 < Δx) (hΔt : 0 < Δt) (hε : 0 < ε)
    (hσ₀ : 0 < σ₀) (hσ : ∀ j, σ₀ ≤ σ j)
    (hcfl : Δt ≤ 1 / (4 * ((N : ℝ) + 2)) * (ε * Δx + σ₀ * Δx ^ 2))
    {ρ ρ₁ : Matrix (ZMod Nx) Unit ℝ} {X : Matrix (ZMod Nx) r ℝ} {S : Matrix r r ℝ}
    {V : Matrix (Fin N) r ℝ} {K₁ : Matrix (ZMod Nx) r ℝ} {L₁ : Matrix (Fin N) r ℝ}
    {X₁ : Matrix (ZMod Nx) p ℝ} {V₁ : Matrix (Fin N) q ℝ} {S₁ : Matrix p q ℝ}
    (h : IsMicroMacroBUGStep σ (transport μ w Δx) (Dp Nx Δx * ρ) (aVec N) Δt ε
      X S V K₁ L₁ X₁ V₁ S₁)
    (hρ : Δt⁻¹ • (ρ₁ - ρ) + Dm Nx Δx * (X₁ * S₁ * V₁ᵀ * aVec N) = 0) :
    energy Δx ε ρ₁ (X₁ * S₁ * V₁ᵀ) ≤ energy Δx ε ρ (X * S * Vᵀ) :=
  energy_stable_dlra_of_cfl hG hΔx hΔt hε hσ₀ hσ (cfl_of_le hG hΔx hΔt hε hσ₀ hcfl) h hρ

/-- **Theorem 5.1 (time-continuous `S`-step), corrected, the identity**, arXiv 2212.12012.  For the
Galerkin equation (5.1), with the macro equation `ρ̇ + D⁻ (gˢ a) = 0` and `gˢ = X₁ S Vᵀ`:

`½ d/dt (‖ρ‖² + ε² ‖gˢ‖²) = -ε (Δx/2) ∑_j (D⁺gˢ_j)ᵀ |A| D⁺gˢ_j - ∑_j σ_j |gˢ_j|²`,

in the Frobenius norm, as printed.  The last display of the printed proof has
`-ε⁻¹ (…) - ε⁻² σ (…)` on the right: that is the derivative of `ε⁻² ‖ρ‖² + ‖gˢ‖²`, not of the energy
on its left, and it also drops the `Δx/2` of Lemma 3.5.  See `theorem_5_1_printed_false`. -/
theorem energy_identity (hΔx : 0 < Δx) (hε : 0 < ε) {X₁ : Matrix (ZMod Nx) p ℝ}
    {V₁ : Matrix (Fin N) q ℝ} (hX₁ : X₁ᵀ * X₁ = 1) (hV₁ : V₁ᵀ * V₁ = 1) {S : ℝ → Matrix p q ℝ}
    {ρ : ℝ → Matrix (ZMod Nx) Unit ℝ}
    (hS : ∀ t, HasDerivAt S (-(ε⁻¹ • (X₁ᵀ * transport μ w Δx (X₁ * S t * V₁ᵀ) * V₁)) -
      (ε ^ 2)⁻¹ • (X₁ᵀ * (Dp Nx Δx * ρ t) * ((aVec N)ᵀ * V₁) + stiffness σ X₁ * S t)) t)
    (hρ : ∀ t, HasDerivAt ρ (-(Dm Nx Δx * (X₁ * S t * V₁ᵀ * aVec N))) t) (t : ℝ) :
    HasDerivAt (fun s => (1 / 2 : ℝ) * (‖ρ s‖ ^ 2 + ε ^ 2 * ‖X₁ * S s * V₁ᵀ‖ ^ 2))
      (-(ε * (Δx / 2 * ⟪Dp Nx Δx * (X₁ * S t * V₁ᵀ),
          Dp Nx Δx * (X₁ * S t * V₁ᵀ) * absA μ w⟫)) -
        ⟪X₁ * S t * V₁ᵀ, Matrix.diagonal σ * (X₁ * S t * V₁ᵀ)⟫) t := by
  set g := X₁ * S t * V₁ᵀ with hg
  set Sd := -(ε⁻¹ • (X₁ᵀ * transport μ w Δx g * V₁)) -
      (ε ^ 2)⁻¹ • (X₁ᵀ * (Dp Nx Δx * ρ t) * ((aVec N)ᵀ * V₁) + stiffness σ X₁ * S t) with hSd
  have hgd : HasDerivAt (fun s => X₁ * S s * V₁ᵀ) (X₁ * Sd * V₁ᵀ) t :=
    Frobenius.hasDerivAt_mul_const V₁ᵀ (Frobenius.hasDerivAt_const_mul X₁ (hS t))
  have h1 := (hρ t).norm_sq
  have h2 := hgd.norm_sq
  have h3 := ((h1.add (h2.const_mul (ε ^ 2))).const_mul (1 / 2 : ℝ))
  refine h3.congr_deriv ?_
  rw [← hg]
  have hgg : ⟪g, X₁ * Sd * V₁ᵀ⟫ = ⟪S t, Sd⟫ := by
    have h4 : X₁ᵀ * (X₁ * Sd * V₁ᵀ) * V₁ = Sd := by
      calc X₁ᵀ * (X₁ * Sd * V₁ᵀ) * V₁ = (X₁ᵀ * X₁) * Sd * (V₁ᵀ * V₁) := by
            simp only [Matrix.mul_assoc]
        _ = Sd := by rw [hX₁, hV₁, Matrix.one_mul, Matrix.mul_one]
    rw [hg, ← inner_core, h4]
  have hstiff : stiffness σ X₁ * S t = X₁ᵀ * (Matrix.diagonal σ * g) * V₁ := by
    rw [stiffness, hg]
    simp only [Matrix.mul_assoc, hV₁, Matrix.mul_one]
  have hd : X₁ᵀ * (Dp Nx Δx * ρ t) * ((aVec N)ᵀ * V₁) =
      X₁ᵀ * (Dp Nx Δx * ρ t * (aVec N)ᵀ) * V₁ := by
    simp only [Matrix.mul_assoc]
  have e4 : ⟪g, Dp Nx Δx * ρ t * (aVec N)ᵀ⟫ = -⟪ρ t, Dm Nx Δx * (g * aVec N)⟫ := by
    rw [← Frobenius.inner_mul_right, real_inner_comm, sbp_Dm, neg_neg]
  have hSS : ⟪S t, Sd⟫ = -(ε⁻¹ * ⟪g, transport μ w Δx g⟫) -
      (ε ^ 2)⁻¹ * (⟪g, Dp Nx Δx * ρ t * (aVec N)ᵀ⟫ + ⟪g, Matrix.diagonal σ * g⟫) := by
    rw [hSd, hstiff, hd, inner_sub_right, inner_neg_right, inner_smul_right, inner_smul_right,
      inner_add_right, inner_core, inner_core, inner_core]
  rw [hgg, hSS, e4, inner_neg_right, inner_transport_self hΔx.ne']
  have he := hε.ne'
  field_simp
  ring

/-- The dissipation in `energy_identity` is at most `-σ₀ ‖g‖²`, since `|A|` is positive
semidefinite. -/
theorem dissipation_le (hΔx : 0 < Δx) (hε : 0 < ε) (hσ : ∀ j, σ₀ ≤ σ j)
    (g : Matrix (ZMod Nx) (Fin N) ℝ) :
    -(ε * (Δx / 2 * ⟪Dp Nx Δx * g, Dp Nx Δx * g * absA μ w⟫)) -
      ⟪g, Matrix.diagonal σ * g⟫ ≤ -(σ₀ * ‖g‖ ^ 2) := by
  have h1 := le_inner_diagonal hσ g
  have h2 : 0 ≤ ⟪Dp Nx Δx * g, Dp Nx Δx * g * absA μ w⟫ := by
    rw [absA, absM, inner_mul_T_diag]
    exact Finset.sum_nonneg fun j _ => Finset.sum_nonneg fun k _ => by positivity
  have h3 : 0 ≤ ε * (Δx / 2 * ⟪Dp Nx Δx * g, Dp Nx Δx * g * absA μ w⟫) := by positivity
  linarith

/-- **Theorem 5.1 (time-continuous `S`-step), corrected**, arXiv 2212.12012: the solution of the
Galerkin equation (5.1) with the macro equation dissipates the energy, with
`½ d/dt (‖ρ‖² + ε² ‖gˢ‖²) ≤ -σ₀ ‖gˢ‖²` for `σ ≥ σ₀`.  The printed rate `-σ₀ ε⁻² ‖gˢ‖²` is false
for `ε < 1`, see `theorem_5_1_printed_false`; it holds with `ε⁻² ‖ρ‖² + ‖gˢ‖²` on the left,
which is this statement divided by `ε²`.  The printed `σ₀(x_{j+1/2})` is the constant `σ₀` of the
proof of Theorem 3.2.  The abstract core, norm dissipation for a Galerkin ODE, is in
`LeanDLRA.Foundations.Galerkin`. -/
theorem energy_dissipation (hΔx : 0 < Δx) (hε : 0 < ε) (hσ : ∀ j, σ₀ ≤ σ j)
    {X₁ : Matrix (ZMod Nx) p ℝ} {V₁ : Matrix (Fin N) q ℝ} (hX₁ : X₁ᵀ * X₁ = 1)
    (hV₁ : V₁ᵀ * V₁ = 1) {S : ℝ → Matrix p q ℝ} {ρ : ℝ → Matrix (ZMod Nx) Unit ℝ}
    (hS : ∀ t, HasDerivAt S (-(ε⁻¹ • (X₁ᵀ * transport μ w Δx (X₁ * S t * V₁ᵀ) * V₁)) -
      (ε ^ 2)⁻¹ • (X₁ᵀ * (Dp Nx Δx * ρ t) * ((aVec N)ᵀ * V₁) + stiffness σ X₁ * S t)) t)
    (hρ : ∀ t, HasDerivAt ρ (-(Dm Nx Δx * (X₁ * S t * V₁ᵀ * aVec N))) t) (t : ℝ) :
    ∃ D, HasDerivAt (fun s => (1 / 2 : ℝ) * (‖ρ s‖ ^ 2 + ε ^ 2 * ‖X₁ * S s * V₁ᵀ‖ ^ 2)) D t ∧
      D ≤ -(σ₀ * ‖X₁ * S t * V₁ᵀ‖ ^ 2) :=
  ⟨_, energy_identity hΔx hε hX₁ hV₁ hS hρ t, dissipation_le hΔx hε hσ _⟩

end DLRA

section Examples

variable {N : ℕ}

/-- The unit column `e_i`. -/
private def basisCol (i : Fin N) : Matrix (Fin N) (Fin 1) ℝ :=
  Matrix.of fun l _ => if l = i then 1 else 0

private theorem basisCol_orth (i : Fin N) : (basisCol i)ᵀ * basisCol i = 1 := by
  ext a b
  obtain rfl : a = 0 := Subsingleton.elim _ _
  obtain rfl : b = 0 := Subsingleton.elim _ _
  simp [Matrix.mul_apply, basisCol]

/-- `Vᵀ B V` for `V = e_i`. -/
private theorem basisCol_quad (i : Fin N) (B : Matrix (Fin N) (Fin N) ℝ) :
    (basisCol i)ᵀ * B * basisCol i = Matrix.of fun _ _ => B i i := by
  ext a b
  simp [Matrix.mul_apply, basisCol]

/-- The constant unit vector on two cells. -/
private noncomputable def XConst : Matrix (ZMod 2) (Fin 1) ℝ := Matrix.of fun _ _ => 1 / √2

private theorem sum_zmod2 (f : ZMod 2 → ℝ) : ∑ j, f j = f 0 + f 1 := Fin.sum_univ_two f

private theorem XConst_orth : XConstᵀ * XConst = 1 := by
  ext a b
  obtain rfl : a = 0 := Subsingleton.elim _ _
  obtain rfl : b = 0 := Subsingleton.elim _ _
  have h : (1 / √2 : ℝ) * (1 / √2) = 1 / 2 := by
    rw [div_mul_div_comm, Real.mul_self_sqrt (by norm_num)]
    norm_num
  simp only [Matrix.mul_apply, Matrix.transpose_apply, XConst, Matrix.of_apply, sum_zmod2, h,
    Matrix.one_apply_eq]
  norm_num

private theorem Dp_XConst {Δx : ℝ} : Dp 2 Δx * XConst = 0 := by
  ext j l
  simp [Dp_mul_apply, XConst]

private theorem Dm_XConst {Δx : ℝ} : Dm 2 Δx * XConst = 0 := by
  ext j l
  simp [Dm_mul_apply, XConst]

/-- **Theorem 5.1 is false as printed**, arXiv 2212.12012: the printed rate
`½ d/dt (‖ρ‖² + ε² ‖gˢ‖²) ≤ -σ₀ ε⁻² ‖gˢ‖²` fails for every `ε < 1`.  On two cells with `σ = σ₀ = 1`,
constant `X₁`, and `ρ = 0`, the equation (5.1) is `Ṡ = -ε⁻² S`, and the left side is `-‖gˢ‖²` at
every time.  The correct statements are `energy_identity` and `energy_dissipation`. -/
theorem theorem_5_1_printed_false {μ w : Fin (N + 1) → ℝ} {Δx ε : ℝ} (hN : 0 < N) (hΔx : 0 < Δx)
    (hε : 0 < ε) (hε1 : ε < 1) :
    ∃ (X₁ : Matrix (ZMod 2) (Fin 1) ℝ) (V₁ : Matrix (Fin N) (Fin 1) ℝ)
      (S : ℝ → Matrix (Fin 1) (Fin 1) ℝ) (ρ : ℝ → Matrix (ZMod 2) Unit ℝ) (E : ℝ → ℝ),
      X₁ᵀ * X₁ = 1 ∧ V₁ᵀ * V₁ = 1 ∧
      (∀ t, HasDerivAt S (-(ε⁻¹ • (X₁ᵀ * transport μ w Δx (X₁ * S t * V₁ᵀ) * V₁)) -
        (ε ^ 2)⁻¹ • (X₁ᵀ * (Dp 2 Δx * ρ t) * ((aVec N)ᵀ * V₁) +
          stiffness (fun _ => 1) X₁ * S t)) t) ∧
      (∀ t, HasDerivAt ρ (-(Dm 2 Δx * (X₁ * S t * V₁ᵀ * aVec N))) t) ∧
      (∀ t, HasDerivAt (fun s => (1 / 2 : ℝ) * (‖ρ s‖ ^ 2 + ε ^ 2 * ‖X₁ * S s * V₁ᵀ‖ ^ 2))
        (E t) t) ∧
      ∀ t, -(1 / ε ^ 2 * ‖X₁ * S t * V₁ᵀ‖ ^ 2) < E t := by
  set i₀ : Fin N := ⟨0, hN⟩
  set V₁ := basisCol i₀ with hV₁
  set c : ℝ := -(ε ^ 2)⁻¹ with hc
  set S : ℝ → Matrix (Fin 1) (Fin 1) ℝ := fun t => Real.exp (c * t) • 1 with hS
  have hDm : ∀ t, Dm 2 Δx * (XConst * S t * V₁ᵀ) = 0 := fun t => by
    rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, Dm_XConst, Matrix.zero_mul, Matrix.zero_mul]
  have hDp : ∀ t, Dp 2 Δx * (XConst * S t * V₁ᵀ) = 0 := fun t => by
    rw [← Matrix.mul_assoc, ← Matrix.mul_assoc, Dp_XConst, Matrix.zero_mul, Matrix.zero_mul]
  have hstiff : stiffness (fun _ : ZMod 2 => (1 : ℝ)) XConst = 1 := by
    rw [stiffness, Matrix.diagonal_one, Matrix.mul_one, XConst_orth]
  have hdS : ∀ t, HasDerivAt S (-(ε⁻¹ • (XConstᵀ * transport μ w Δx (XConst * S t * V₁ᵀ) * V₁)) -
      (ε ^ 2)⁻¹ • (XConstᵀ * (Dp 2 Δx * (0 : Matrix (ZMod 2) Unit ℝ)) * ((aVec N)ᵀ * V₁) +
        stiffness (fun _ => 1) XConst * S t)) t := by
    intro t
    have h1 : HasDerivAt S ((Real.exp (c * t) * (c * 1)) • (1 : Matrix (Fin 1) (Fin 1) ℝ)) t :=
      (((hasDerivAt_id t).const_mul c).exp).smul_const _
    refine h1.congr_deriv ?_
    have hT : transport μ w Δx (XConst * S t * V₁ᵀ) = 0 := by
      rw [transport, hDm, hDp]
      simp
    rw [hT, Matrix.mul_zero, Matrix.zero_mul, smul_zero, neg_zero, zero_sub, Matrix.mul_zero,
      Matrix.mul_zero, Matrix.zero_mul, zero_add, hstiff, Matrix.one_mul]
    simp only [hS, smul_smul, ← neg_smul]
    congr 1
    rw [hc]
    ring
  have hdρ : ∀ t, HasDerivAt (fun _ : ℝ => (0 : Matrix (ZMod 2) Unit ℝ))
      (-(Dm 2 Δx * (XConst * S t * V₁ᵀ * aVec N))) t := by
    intro t
    have h1 : Dm 2 Δx * (XConst * S t * V₁ᵀ * aVec N) = 0 := by
      rw [← Matrix.mul_assoc, hDm, Matrix.zero_mul]
    rw [h1, neg_zero]
    exact hasDerivAt_const t _
  have hid := energy_identity (μ := μ) (w := w) hΔx hε XConst_orth (basisCol_orth i₀) hdS hdρ
  refine ⟨XConst, V₁, S, fun _ => 0, _, XConst_orth, basisCol_orth i₀, hdS, hdρ, hid, fun t => ?_⟩
  have hg : 0 < ‖XConst * S t * V₁ᵀ‖ := by
    rw [Frobenius.norm_mul_transpose_of_orthonormal (basisCol_orth i₀),
      Frobenius.norm_mul_of_orthonormal XConst_orth, norm_pos_iff]
    intro h0
    have h1 := congrFun (congrFun h0 0) 0
    simp only [hS, Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul, mul_one,
      Matrix.zero_apply] at h1
    exact (Real.exp_pos _).ne' h1
  rw [hDp, Matrix.diagonal_one, Matrix.one_mul]
  simp only [Matrix.zero_mul, inner_zero_left, mul_zero, neg_zero, zero_sub,
    real_inner_self_eq_norm_sq]
  have h2 : 1 < 1 / ε ^ 2 := by
    rw [lt_div_iff₀ (by positivity), one_mul]
    nlinarith
  have h3 : 0 < ‖XConst * S t * V₁ᵀ‖ ^ 2 := by positivity
  nlinarith

end Examples

section AP

variable {N Nx : ℕ} [NeZero Nx] {μ w : Fin (N + 1) → ℝ} {Δx Δt σ₀ σ₁ : ℝ} {σ : ZMod Nx → ℝ}
  {r p q : Type*} [Fintype r] [Fintype p] [Fintype q] [DecidableEq r] [DecidableEq p]
  [DecidableEq q]

theorem norm_aVec_sq (hN : 0 < N) : ‖aVec N‖ ^ 2 = 1 / 3 := by
  rw [Frobenius.norm_sq_eq_sum, ← coef_zero_sq]
  simp only [Finset.univ_unique, Finset.sum_singleton]
  rw [Finset.sum_eq_single (⟨0, hN⟩ : Fin N)]
  · simp [aVec]
  · intro b _ hb
    have : (b : ℕ) ≠ 0 := fun h => hb (Fin.ext h)
    simp [aVec, this]
  · simp

theorem norm_transport_le (x : Matrix (ZMod Nx) (Fin N) ℝ) :
    ‖transport μ w Δx x‖ ≤
      (‖Dm Nx Δx‖ * ‖plusA μ w‖ + ‖Dp Nx Δx‖ * ‖minusA μ w‖) * ‖x‖ := by
  have h1 : ‖Dm Nx Δx * x * plusA μ w‖ ≤ ‖Dm Nx Δx‖ * ‖x‖ * ‖plusA μ w‖ :=
    (Frobenius.norm_mul_le _ _).trans (by gcongr; exact Frobenius.norm_mul_le _ _)
  have h2 : ‖Dp Nx Δx * x * minusA μ w‖ ≤ ‖Dp Nx Δx‖ * ‖x‖ * ‖minusA μ w‖ :=
    (Frobenius.norm_mul_le _ _).trans (by gcongr; exact Frobenius.norm_mul_le _ _)
  calc _ ≤ _ := norm_add_le _ _
    _ ≤ _ := add_le_add h1 h2
    _ = _ := by ring

/-- `‖D⁻ x‖ = ‖D⁺ x‖ ≤ (2/Δx) ‖x‖`. -/
theorem norm_Dp_mul_le (hΔx : 0 < Δx) {n : Type*} [Fintype n] (x : Matrix (ZMod Nx) n ℝ) :
    ‖Dp Nx Δx * x‖ ≤ 2 / Δx * ‖x‖ := by
  have h : ‖Dp Nx Δx * x‖ ^ 2 ≤ (2 / Δx * ‖x‖) ^ 2 := by
    rw [mul_pow, div_pow, Frobenius.norm_sq_eq_sum, Frobenius.norm_sq_eq_sum, Finset.sum_comm,
      Finset.sum_comm (f := fun j l => x j l ^ 2), Finset.mul_sum]
    refine Finset.sum_le_sum fun l _ => (sum_Dp_sq_le x l).trans_eq ?_
    norm_num
  exact (sq_le_sq₀ (norm_nonneg _) (by positivity)).1 h

/-- **Theorem 4.1 (asymptotic preservation), arXiv 2212.12012, corrected.**  Fix the data `ρⁿ`,
`Xⁿ`, `Sⁿ`, `Vⁿ` of the fully discrete scheme of §5.2 on the periodic grid (Mathlib has no setting
for the semi-discrete statement; there `∂ₓ` is `D⁺` on `ρ` and `D⁻` on interface fluxes), let
`g = Xⁿ⁺¹ Sⁿ⁺¹ Vⁿ⁺¹ᵀ`, and update `ρ` by (5.4).  If

`aᵀ Vⁿ ≠ 0` and `⟨∂ₓρⁿ, Xⁿ⟩ ≠ 0`,

then for every family of steps, every rank and every orthonormal bases capturing `K` and `L`, as
`ε → 0`,

`(ρⁿ⁺¹ - ρⁿ) / Δt - ⅓ ∂ₓ(σ⁻¹ ∂ₓρⁿ) → 0`,

which is (4.9).  The printed theorem has no hypothesis at all and is false without one
(`theorem_4_1_printed_false`).  The condition in its proof cannot replace the ones above:
`KineticAP.not_isUnit_of_lLimit_eq` shows it can never hold for `r ≥ 2`, and
`printed_hypothesis_not_uniform` covers the reading at `ε > 0`.  The exact algebra of the printed
proof is `KineticAP.sLimit_eq_diffFlux_iff`. -/
theorem theorem_4_1 (hN : 0 < N) (hΔt : 0 < Δt) (hσ : IsCrossSection σ σ₀ σ₁)
    {ρ : Matrix (ZMod Nx) Unit ℝ} {X : Matrix (ZMod Nx) r ℝ} {S : Matrix r r ℝ}
    {V : Matrix (Fin N) r ℝ} (hb : Vᵀ * aVec N ≠ 0) (hc : Xᵀ * (Dp Nx Δx * ρ) ≠ 0)
    {K₁ : ℝ → Matrix (ZMod Nx) r ℝ} {L₁ : ℝ → Matrix (Fin N) r ℝ}
    {X₁ : ℝ → Matrix (ZMod Nx) p ℝ} {V₁ : ℝ → Matrix (Fin N) q ℝ} {S₁ : ℝ → Matrix p q ℝ}
    {ρ₁ : ℝ → Matrix (ZMod Nx) Unit ℝ}
    (h : ∀ ε > 0, IsMicroMacroBUGStep σ (transport μ w Δx) (Dp Nx Δx * ρ) (aVec N) Δt ε
      X S V (K₁ ε) (L₁ ε) (X₁ ε) (V₁ ε) (S₁ ε))
    (hρ : ∀ ε > 0, Δt⁻¹ • (ρ₁ ε - ρ) + Dm Nx Δx * (X₁ ε * S₁ ε * (V₁ ε)ᵀ * aVec N) = 0) :
    Tendsto (fun ε => ‖Δt⁻¹ • (ρ₁ ε - ρ) - (1 / 3 : ℝ) • (Dm Nx Δx * ceDir σ (Dp Nx Δx * ρ))‖)
      (𝓝[>] 0) (𝓝 0) := by
  have hτ0 : 0 ≤ ‖Dm Nx Δx‖ * ‖plusA μ w‖ + ‖Dp Nx Δx‖ * ‖minusA μ w‖ := by positivity
  have hlim := (tendsto_diffFlux hσ hτ0 norm_transport_le hΔt hb hc h).const_mul
    (‖Dm Nx Δx‖ * ‖aVec N‖)
  rw [mul_zero] at hlim
  refine squeeze_zero' (Eventually.of_forall fun _ => norm_nonneg _) ?_ hlim
  filter_upwards [self_mem_nhdsWithin] with ε hε
  have hflux := diffFlux_mul σ (Dp Nx Δx * ρ) (aVec N)
  rw [norm_aVec_sq hN] at hflux
  have h1 : Δt⁻¹ • (ρ₁ ε - ρ) - (1 / 3 : ℝ) • (Dm Nx Δx * ceDir σ (Dp Nx Δx * ρ)) =
      -(Dm Nx Δx * ((X₁ ε * S₁ ε * (V₁ ε)ᵀ - diffFlux σ (Dp Nx Δx * ρ) (aVec N)) * aVec N)) := by
    have h2 := eq_neg_of_add_eq_zero_left (hρ ε hε)
    rw [h2, Matrix.sub_mul, hflux, Matrix.mul_sub, Matrix.mul_neg, Matrix.mul_smul]
    abel
  rw [h1, norm_neg]
  calc _ ≤ ‖Dm Nx Δx‖ * ‖(X₁ ε * S₁ ε * (V₁ ε)ᵀ - diffFlux σ (Dp Nx Δx * ρ) (aVec N)) * aVec N‖ :=
        Frobenius.norm_mul_le _ _
    _ ≤ ‖Dm Nx Δx‖ * (‖X₁ ε * S₁ ε * (V₁ ε)ᵀ - diffFlux σ (Dp Nx Δx * ρ) (aVec N)‖ * ‖aVec N‖) := by
        gcongr
        exact Frobenius.norm_mul_le _ _
    _ = _ := by ring

/-- **Theorem 4.1 for a whole run**, arXiv 2212.12012: this is `KineticAP.ap_run` for the concrete
scheme of §5.2.  If `aᵀ V⁰ ≠ 0`, `⟨D⁺ρ⁰, X⁰⟩ ≠ 0` and `Δt < ¾ σ₀ Δx²`, then at every step the
density converges with rate `ε` to the explicit Euler iterate of the discrete diffusion equation,
and the micro variable to the diffusive flux.  The hypotheses are at time `0` only.  The condition
on `Δt` is the sufficient one of `ap_run`; the paper has none. -/
theorem theorem_4_1_run (hN : 0 < N) (hΔx : 0 < Δx) (hΔt : 0 < Δt) (hσ : IsCrossSection σ σ₀ σ₁)
    (hcfl : Δt < 3 / 4 * σ₀ * Δx ^ 2) {ρ₀ : Matrix (ZMod Nx) Unit ℝ} {X₀ : Matrix (ZMod Nx) r ℝ}
    {S₀ : Matrix r r ℝ} {V₀ : Matrix (Fin N) r ℝ} {ρ : ℝ → ℕ → Matrix (ZMod Nx) Unit ℝ}
    {X : ℝ → ℕ → Matrix (ZMod Nx) r ℝ} {S : ℝ → ℕ → Matrix r r ℝ}
    {V : ℝ → ℕ → Matrix (Fin N) r ℝ}
    (hrun : ∀ ε > 0, IsMicroMacroRun σ (transport μ w Δx) (Dp Nx Δx) (aVec N) Δt ε
      (ρ ε) (X ε) (S ε) (V ε))
    (h0 : ∀ ε > 0, ρ ε 0 = ρ₀ ∧ X ε 0 = X₀ ∧ S ε 0 = S₀ ∧ V ε 0 = V₀)
    (hb : V₀ᵀ * aVec N ≠ 0) (hc : X₀ᵀ * (Dp Nx Δx * ρ₀) ≠ 0) (k : ℕ) :
    (∃ C : ℝ, ∀ᶠ ε in 𝓝[>] (0 : ℝ),
      ‖ρ ε k - diffIter (Dp Nx Δx) σ (aVec N) Δt ρ₀ k‖ ≤ C * ε) ∧
    (∃ C : ℝ, ∀ᶠ ε in 𝓝[>] (0 : ℝ),
      ‖X ε (k + 1) * S ε (k + 1) * (V ε (k + 1))ᵀ -
        diffFlux σ (Dp Nx Δx * diffIter (Dp Nx Δx) σ (aVec N) Δt ρ₀ k) (aVec N)‖ ≤ C * ε) := by
  have hτ0 : 0 ≤ ‖Dm Nx Δx‖ * ‖plusA μ w‖ + ‖Dp Nx Δx‖ * ‖minusA μ w‖ := by positivity
  have hΓ : ∀ x : Matrix (ZMod Nx) Unit ℝ, ‖(Dp Nx Δx)ᵀ * x‖ ≤ 2 / Δx * ‖x‖ := by
    intro x
    rw [Dp_transpose, Matrix.neg_mul, norm_neg, norm_Dm_mul]
    exact norm_Dp_mul_le hΔx x
  have hcfl' : Δt * ‖aVec N‖ ^ 2 * (2 / Δx) ^ 2 < σ₀ := by
    rw [norm_aVec_sq hN, div_pow]
    have h1 : Δt * (1 / 3) * (2 ^ 2 / Δx ^ 2) = 4 / 3 * (Δt / Δx ^ 2) := by ring
    rw [h1]
    have h2 : Δt / Δx ^ 2 < 3 / 4 * σ₀ := by
      rw [div_lt_iff₀ (by positivity)]
      exact hcfl
    linarith
  exact ap_run hσ hτ0 norm_transport_le hΔt hΓ hcfl' hrun h0 hb hc k

end AP

section Printed41

/-- **The hypothesis in the proof of Theorem 4.1 cannot hold uniformly as `ε → 0`**,
arXiv 2212.12012.  `KineticAP.not_isUnit_of_lLimit_eq` treats the limit equation, which is what the
printed proof writes: there `S_L ⟨X Xᵀ σ⟩` is singular for every `r ≥ 2`, every `σ`, `∂ₓρ`, `a`,
`X`.  This theorem treats the other reading, a QR factorisation `L₁ ε = Q ε (SL ε)` at each
`ε > 0`, for any transport `𝒯` and any `r ≥ 2`: whenever `SL ε ⟨X Xᵀ σ⟩` is invertible, the norm of
its inverse is unbounded as `ε → 0`, because `L₁ ε` tends to a matrix of rank at most one. -/
theorem printed_hypothesis_not_uniform {m n r p q : Type*} [Fintype m] [Fintype n] [Fintype r]
    [Fintype p] [Fintype q] [DecidableEq m] [DecidableEq r] [DecidableEq p] [DecidableEq q]
    {σ : m → ℝ} {σ₀ σ₁ τ dt : ℝ} {𝒯 : Matrix m n ℝ → Matrix m n ℝ} {d : Matrix m Unit ℝ}
    {a : Matrix n Unit ℝ} {X : Matrix m r ℝ} {S : Matrix r r ℝ} {V : Matrix n r ℝ}
    (hr : 2 ≤ Fintype.card r) (hσ : IsCrossSection σ σ₀ σ₁) (hτ0 : 0 ≤ τ)
    (hτ : ∀ x, ‖𝒯 x‖ ≤ τ * ‖x‖) (hdt : 0 < dt) {K₁ : ℝ → Matrix m r ℝ} {L₁ : ℝ → Matrix n r ℝ}
    {X₁ : ℝ → Matrix m p ℝ} {V₁ : ℝ → Matrix n q ℝ} {S₁ : ℝ → Matrix p q ℝ}
    (h : ∀ ε > 0, IsMicroMacroBUGStep σ 𝒯 d a dt ε X S V (K₁ ε) (L₁ ε) (X₁ ε) (V₁ ε) (S₁ ε))
    {Q : ℝ → Matrix n r ℝ} {SL : ℝ → Matrix r r ℝ} (hQ : ∀ ε > 0, (Q ε)ᵀ * Q ε = 1)
    (hL : ∀ ε > 0, L₁ ε = Q ε * SL ε) (C : ℝ) :
    ¬ ∀ᶠ ε in 𝓝[>] (0 : ℝ), ∃ W, SL ε * stiffness σ X * W = 1 ∧ ‖W‖ ≤ C := by
  intro hev
  set c := lCoeff σ d X with hc
  obtain ⟨y, hy0, hy⟩ : ∃ y : Matrix r Unit ℝ, y ≠ 0 ∧ cᵀ * y = 0 := by
    have hf : LinearMap.ker (cᵀ).mulVecLin ≠ ⊥ := by
      refine LinearMap.ker_ne_bot_of_finrank_lt ?_
      simpa using Nat.lt_of_succ_le hr
    obtain ⟨v, hv, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hf
    refine ⟨Matrix.of fun i _ => v i, fun h0 => hv0 ?_, ?_⟩
    · ext i
      exact congrFun (congrFun h0 i) ()
    · have hv' : cᵀ *ᵥ v = 0 := by rwa [LinearMap.mem_ker, Matrix.mulVecLin_apply] at hv
      ext u u'
      have := congrFun hv' u
      simpa [Matrix.mul_apply, Matrix.mulVec, dotProduct] using this
  have hL0 : lLimit σ d a X * y = 0 := by
    rw [lLimit, ← hc, Matrix.neg_mul, Matrix.mul_assoc, hy, Matrix.mul_zero, neg_zero]
  have hypos : 0 < ‖y‖ := norm_pos_iff.2 hy0
  set M := stiffness σ X with hM
  have hk : 0 ≤ kappa σ₀ σ₁ := by linarith [hσ.one_le_kappa]
  set F := kappa σ₀ σ₁ * ‖ceDir σ d‖ * ‖a‖ with hF
  have hlim := (tendsto_apPhi (B := ‖S‖) (F := F) hdt hσ.pos hτ0 (norm_nonneg _)
    (by positivity)).const_mul (‖M‖ * C)
  rw [mul_zero] at hlim
  have hsmall := hlim.eventually (Iio_mem_nhds one_pos)
  obtain ⟨ε, ⟨W, hW, hWC⟩, hsm, hε⟩ := (hev.and (hsmall.and self_mem_nhdsWithin)).exists
  have hε' : 0 < ε := hε
  have hsm' : ‖M‖ * C * apPhi dt ε σ₀ τ ‖S‖ F < 1 := hsm
  have h1 : SL ε * y = (Q ε)ᵀ * ((L₁ ε - lLimit σ d a X) * y) := by
    rw [Matrix.sub_mul, hL0, sub_zero, hL ε hε', Matrix.mul_assoc, ← Matrix.mul_assoc, hQ ε hε',
      Matrix.one_mul]
  have h2 : ‖SL ε * y‖ ≤ apPhi dt ε σ₀ τ ‖S‖ F * ‖y‖ := by
    rw [h1]
    refine (norm_transpose_mul_le (hQ ε hε') _).trans ((Frobenius.norm_mul_le _ _).trans ?_)
    have := lStep_le hσ hτ0 hτ hdt hε' (h ε hε')
    gcongr
  have h3 : M * W * (SL ε * y) = y := by
    have h4 : SL ε * (M * W) = 1 := by rw [← Matrix.mul_assoc, hW]
    rw [← Matrix.mul_assoc, mul_eq_one_comm.1 h4, Matrix.one_mul]
  have hC : 0 ≤ C := (norm_nonneg _).trans hWC
  have h4 : ‖y‖ ≤ ‖M‖ * C * (apPhi dt ε σ₀ τ ‖S‖ F * ‖y‖) := by
    calc ‖y‖ = ‖M * W * (SL ε * y)‖ := by rw [h3]
      _ ≤ ‖M * W‖ * ‖SL ε * y‖ := Frobenius.norm_mul_le _ _
      _ ≤ (‖M‖ * ‖W‖) * ‖SL ε * y‖ := by gcongr; exact Frobenius.norm_mul_le _ _
      _ ≤ (‖M‖ * C) * (apPhi dt ε σ₀ τ ‖S‖ F * ‖y‖) := by gcongr
  nlinarith [mul_pos hypos (sub_pos.2 hsm')]

variable {N : ℕ} {μ w : Fin (N + 1) → ℝ} {Δx Δt : ℝ}

private theorem sum_zmod3 (f : ZMod 3 → ℝ) : ∑ j, f j = f 0 + f 1 + f 2 := Fin.sum_univ_three f

private theorem zmod3 (j : ZMod 3) : j = 0 ∨ j = 1 ∨ j = 2 := by
  revert j
  decide

/-- A zero-mean vector on three cells, an eigenvector of `D⁻ D⁺`. -/
private noncomputable def cexX : Matrix (ZMod 3) (Fin 1) ℝ :=
  Matrix.of fun j _ => if j = 0 then 1 / √2 else if j = 1 then -(1 / √2) else 0

/-- The density of the counterexample: `∂ₓρ` is not proportional to `cexX`. -/
private def cexρ : Matrix (ZMod 3) Unit ℝ := Matrix.of fun j _ => if j = 0 then 0 else 1

private theorem cexX_zero (l : Fin 1) : cexX 0 l = 1 / √2 := by simp [cexX]

private theorem cexX_one (l : Fin 1) : cexX 1 l = -(1 / √2) := by simp [cexX]

private theorem cexX_two (l : Fin 1) : cexX 2 l = 0 := by
  have h0 : (2 : ZMod 3) ≠ 0 := by decide
  have h1 : (2 : ZMod 3) ≠ 1 := by decide
  simp [cexX, h0, h1]

private theorem cexX_orth : cexXᵀ * cexX = 1 := by
  ext a b
  obtain rfl : a = 0 := Subsingleton.elim _ _
  obtain rfl : b = 0 := Subsingleton.elim _ _
  have h : (1 / √2 : ℝ) * (1 / √2) = 1 / 2 := by
    rw [div_mul_div_comm, Real.mul_self_sqrt (by norm_num)]
    norm_num
  simp only [Matrix.mul_apply, Matrix.transpose_apply, sum_zmod3, cexX_zero, cexX_one, cexX_two,
    Matrix.one_apply_eq]
  linarith

private theorem cexX_mean (j : ZMod 3) (l : Fin 1) :
    cexX (j + 1) l + cexX (j - 1) l + cexX j l = 0 := by
  have e1 : (0 + 1 : ZMod 3) = 1 := by decide
  have e2 : (0 - 1 : ZMod 3) = 2 := by decide
  have e3 : (1 + 1 : ZMod 3) = 2 := by decide
  have e4 : (1 - 1 : ZMod 3) = 0 := by decide
  have e5 : (2 + 1 : ZMod 3) = 0 := by decide
  have e6 : (2 - 1 : ZMod 3) = 1 := by decide
  rcases zmod3 j with rfl | rfl | rfl
  · rw [e1, e2, cexX_one, cexX_two, cexX_zero]; ring
  · rw [e3, e4, cexX_two, cexX_zero, cexX_one]; ring
  · rw [e5, e6, cexX_zero, cexX_one, cexX_two]; ring

/-- For `V = e_i` with `A_{ii} = 0`, the transport term of the `K`-step acts on `cexX` as
`3 |A|_{ii} / (2 Δx)`. -/
private theorem cex_transport (hG : IsGaussRule N μ w) (i : Fin N) (hΔx : Δx ≠ 0) :
    transport μ w Δx (cexX * (1 : Matrix (Fin 1) (Fin 1) ℝ) * (basisCol i)ᵀ) * basisCol i =
      (3 * absA μ w i i / (2 * Δx)) • cexX := by
  have hA : fluxA μ w i i = 0 := by
    rw [hG.fluxA_apply]
    simp
  have h1 : plusA μ w i i + minusA μ w i i = 0 := by
    rw [← Matrix.add_apply, plusA_add_minusA, hA]
  have h2 : absA μ w i i = plusA μ w i i - minusA μ w i i := by
    rw [← Matrix.sub_apply, plusA_sub_minusA]
  rw [transport_kStep, Matrix.mul_one, basisCol_quad, basisCol_quad]
  ext j l
  obtain rfl : l = 0 := Subsingleton.elim _ _
  rw [Matrix.add_apply, Matrix.mul_apply, Matrix.mul_apply]
  simp only [Finset.univ_unique, Finset.sum_singleton, Fin.default_eq_zero, Matrix.of_apply,
    Matrix.smul_apply, smul_eq_mul, Dp_mul_apply, Dm_mul_apply]
  have h3 := cexX_mean j 0
  have hm : minusA μ w i i = -plusA μ w i i := by linarith
  rw [h2, hm]
  field_simp
  linear_combination (-(2 : ℝ)) * plusA μ w i i * h3

/-- **Theorem 4.1 is false as printed**, arXiv 2212.12012.  The printed statement has no hypothesis;
the hypothesis of its proof does not rescue it either.  For `P_N`, every `N ≥ 2`, on three cells
with `σ = 1` and rank `r = 1`, there are `ρⁿ`, `Xⁿ`, `Vⁿ` with `aᵀ Vⁿ = 0` such that

* the hypothesis of the printed proof holds: `L₀ = V₁ S_L` with `S_L ⟨Xⁿ Xⁿᵀ σ⟩` invertible, for the
  limit `L₀` of the `L`-step (`Sⁿ = 1`);
* steps of the scheme exist for every `ε > 0`, whatever the choice of bases;
* for every `ε > 0` except one value, every step and macro update (5.4) miss (4.9) by the fixed
  amount `1 / (2 Δx²)`, so `(ρⁿ⁺¹ - ρⁿ) / Δt - ⅓ ∂ₓ(σ⁻¹ ∂ₓρⁿ)` does not tend to `0`.

The mechanism: since `aᵀ Vⁿ = 0`, the `K`-step never sees `∂ₓρⁿ`, so `Xⁿ⁺¹` stays in `range Xⁿ`, and
the conclusion "`σ⁻¹ ∂ₓρⁿ ∈ range Xⁿ⁺¹`" of the printed proof fails: that inclusion never followed
from the `L`-step.  Compare `theorem_4_1`, and `KineticAP.ap_fails_with_V_perp_a`, the same
phenomenon for the micro variable and an abstract transport. -/
theorem theorem_4_1_printed_false (hG : IsGaussRule N μ w) (hN : 2 ≤ N) (hΔx : 0 < Δx)
    (hΔt : 0 < Δt) :
    ∃ (ρ : Matrix (ZMod 3) Unit ℝ) (X : Matrix (ZMod 3) (Fin 1) ℝ)
      (V : Matrix (Fin N) (Fin 1) ℝ) (ε₀ : ℝ),
      (aVec N)ᵀ * V = 0 ∧
      (∃ (Q : Matrix (Fin N) (Fin 1) ℝ) (SL : Matrix (Fin 1) (Fin 1) ℝ), Qᵀ * Q = 1 ∧
        lLimit (fun _ : ZMod 3 => (1 : ℝ)) (Dp 3 Δx * ρ) (aVec N) X = Q * SL ∧
        IsUnit (SL * stiffness (fun _ : ZMod 3 => (1 : ℝ)) X)) ∧
      (∀ ε > 0, ∃ (K₁ : Matrix (ZMod 3) (Fin 1) ℝ) (L₁ : Matrix (Fin N) (Fin 1) ℝ)
        (X₁ : Matrix (ZMod 3) (Fin 1) ℝ) (V₁ : Matrix (Fin N) (Fin 1) ℝ)
        (S₁ : Matrix (Fin 1) (Fin 1) ℝ),
        IsMicroMacroBUGStep (fun _ : ZMod 3 => (1 : ℝ)) (transport μ w Δx) (Dp 3 Δx * ρ) (aVec N)
          Δt ε X 1 V K₁ L₁ X₁ V₁ S₁) ∧
      ∀ ε > 0, ε ≠ ε₀ → ∀ (K₁ : Matrix (ZMod 3) (Fin 1) ℝ) (L₁ : Matrix (Fin N) (Fin 1) ℝ)
        (X₁ : Matrix (ZMod 3) (Fin 1) ℝ) (V₁ : Matrix (Fin N) (Fin 1) ℝ)
        (S₁ : Matrix (Fin 1) (Fin 1) ℝ) (ρ₁ : Matrix (ZMod 3) Unit ℝ),
        IsMicroMacroBUGStep (fun _ : ZMod 3 => (1 : ℝ)) (transport μ w Δx) (Dp 3 Δx * ρ) (aVec N)
          Δt ε X 1 V K₁ L₁ X₁ V₁ S₁ →
        Δt⁻¹ • (ρ₁ - ρ) + Dm 3 Δx * (X₁ * S₁ * V₁ᵀ * aVec N) = 0 →
        1 / (2 * Δx ^ 2) ≤ ‖Δt⁻¹ • (ρ₁ - ρ) -
          (1 / 3 : ℝ) • (Dm 3 Δx * ceDir (fun _ : ZMod 3 => (1 : ℝ)) (Dp 3 Δx * ρ))‖ := by
  set i : Fin N := ⟨1, by omega⟩ with hi
  set i₀ : Fin N := ⟨0, by omega⟩ with hi₀
  set V := basisCol i with hV
  set d := Dp 3 Δx * cexρ with hd
  have hx := hΔx.ne'
  have hd0 : ∀ u, d 0 u = 1 / Δx := fun u => by
    have e1 : (0 + 1 : ZMod 3) = 1 := by decide
    simp [hd, Dp_mul_apply, cexρ, e1]
  have hd1 : ∀ u, d 1 u = 0 := fun u => by
    have e1 : (1 + 1 : ZMod 3) = 2 := by decide
    have e2 : (2 : ZMod 3) ≠ 0 := by decide
    simp [hd, Dp_mul_apply, cexρ, e1, e2]
  have hd2 : ∀ u, d 2 u = -(1 / Δx) := fun u => by
    have e1 : (2 + 1 : ZMod 3) = 0 := by decide
    have e2 : (2 : ZMod 3) ≠ 0 := by decide
    simp [hd, Dp_mul_apply, cexρ, e1, e2, neg_div]
  have haV : (aVec N)ᵀ * V = 0 := by
    ext a b
    have h1 : ¬ ((i : ℕ) = 0) := by simp [hi]
    simp [Matrix.mul_apply, aVec, hV, basisCol, h1]
  have hstiff : stiffness (fun _ : ZMod 3 => (1 : ℝ)) cexX = 1 := by
    rw [stiffness, Matrix.diagonal_one, Matrix.mul_one, cexX_orth]
  refine ⟨cexρ, cexX, V, 3 * absA μ w i i * Δt / (2 * Δx), haV, ?_, ?_, ?_⟩
  · -- the hypothesis of the printed proof
    set b := (cexXᵀ * d) 0 () with hb
    have hbv : b = 1 / √2 * (1 / Δx) := by
      simp only [hb, Matrix.mul_apply, Matrix.transpose_apply, sum_zmod3, cexX_zero, cexX_one,
        cexX_two, hd0, hd1, hd2]
      ring
    have hb0 : b ≠ 0 := by
      rw [hbv]
      positivity
    have hc : lCoeff (fun _ : ZMod 3 => (1 : ℝ)) d cexX = cexXᵀ * d := by
      rw [lCoeff, hstiff, inv_one, Matrix.one_mul]
    have hcoef := (coef_pos 0).ne'
    refine ⟨basisCol i₀, (-(coef 0 * b)) • 1, basisCol_orth i₀, ?_, ?_⟩
    · rw [lLimit, hc]
      ext l a
      obtain rfl : a = 0 := Subsingleton.elim _ _
      have h1 : ((l : ℕ) = 0) ↔ l = i₀ := by
        rw [hi₀, Fin.ext_iff]
      simp only [Matrix.neg_apply, Matrix.mul_apply, Matrix.transpose_apply, Finset.univ_unique,
        Finset.sum_singleton, Matrix.smul_apply, Matrix.one_apply_eq, smul_eq_mul, mul_one,
        Fin.default_eq_zero, aVec, Matrix.of_apply, basisCol, h1, ← hb]
      split_ifs <;> ring
    · rw [hstiff, mul_one, Matrix.isUnit_iff_isUnit_det, Matrix.det_smul, Matrix.det_one, mul_one,
        isUnit_iff_ne_zero]
      simp only [Fintype.card_fin, pow_one]
      exact neg_ne_zero.2 (mul_ne_zero hcoef hb0)
  · -- steps exist
    intro ε hε
    exact exists_step (k := 1) (by simp [ZMod.card]) (by simpa using (by omega : 1 ≤ N))
      (isCrossSection_const one_pos) hΔt hε _ _ _ 1 cexX_orth (basisCol_orth i)
  · -- the defect
    intro ε hε hne K₁ L₁ X₁ V₁ S₁ ρ₁ h hρ
    have hε0 := hε.ne'
    set κ := absA μ w i i with hκ
    have ht : 0 < Δt / ε ^ 2 := by positivity
    have hs : 0 < 1 + Δt / ε ^ 2 := by positivity
    set γ := 1 - Δt / ε * (3 * κ / (2 * Δx)) with hγ
    have hγ0 : γ ≠ 0 := by
      intro h0
      apply hne
      rw [hγ] at h0
      field_simp at h0 ⊢
      linarith
    have hK : (1 + Δt / ε ^ 2) • K₁ = γ • cexX := by
      have hk := h.kStep
      rw [haV, Matrix.mul_zero, zero_add, Matrix.diagonal_one, Matrix.one_mul,
        cex_transport hG i hx, Matrix.mul_one, smul_smul] at hk
      rw [hγ, sub_smul, add_smul, one_smul, one_smul]
      calc K₁ + (Δt / ε ^ 2) • K₁
          = (cexX - (Δt / ε * (3 * κ / (2 * Δx))) • cexX - (Δt / ε ^ 2) • K₁) +
              (Δt / ε ^ 2) • K₁ := by
            rw [← hk]
        _ = _ := sub_add_cancel _ _
    have hcap : X₁ * X₁ᵀ * cexX = cexX := by
      have h1 : X₁ * X₁ᵀ * K₁ = K₁ := h.kCap
      have h2 := congrArg (fun Z => X₁ * X₁ᵀ * Z) hK
      simp only [Matrix.mul_smul, h1] at h2
      rw [hK] at h2
      exact (smul_right_injective _ hγ0 h2).symm
    have hP : cexX * cexXᵀ = X₁ * X₁ᵀ := mul_transpose_eq_of_capture rfl cexX_orth hcap
    set G := X₁ * S₁ * V₁ᵀ * aVec N with hG'
    set y := cexXᵀ * G with hy
    have hXy : G = cexX * y := by
      have h1 : X₁ * X₁ᵀ * G = G := by
        rw [hG']
        calc X₁ * X₁ᵀ * (X₁ * S₁ * V₁ᵀ * aVec N)
            = X₁ * (X₁ᵀ * X₁) * S₁ * V₁ᵀ * aVec N := by simp only [Matrix.mul_assoc]
          _ = _ := by rw [h.hX₁, Matrix.mul_one]
      rw [hy, ← Matrix.mul_assoc, hP, h1]
    set E := Δt⁻¹ • (ρ₁ - cexρ) -
      (1 / 3 : ℝ) • (Dm 3 Δx * ceDir (fun _ : ZMod 3 => (1 : ℝ)) d) with hE
    have hce : ceDir (fun _ : ZMod 3 => (1 : ℝ)) d = d := by
      rw [ceDir_const, inv_one, one_smul]
    have hG1 : ∀ j u, G j u = cexX j 0 * y 0 u := fun j u => by
      rw [hXy, Matrix.mul_apply]
      simp
    have hE_apply : ∀ j u, E j u = -((G j u - G (j - 1) u) / Δx) -
        1 / 3 * ((d j u - d (j - 1) u) / Δx) := by
      intro j u
      have h1 := congrFun (congrFun hρ j) u
      simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.sub_apply, smul_eq_mul, Dm_mul_apply,
        Matrix.zero_apply] at h1
      simp only [hE, hce, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul, Dm_mul_apply]
      linarith
    have e0 : (0 - 1 : ZMod 3) = 2 := by decide
    have e2 : (2 - 1 : ZMod 3) = 1 := by decide
    have hdiff : E 0 () - E 2 () = -(1 / Δx ^ 2) := by
      rw [hE_apply, hE_apply, e0, e2]
      simp only [hG1]
      rw [hd0, hd2, hd1, cexX_zero, cexX_two, cexX_one]
      field_simp
      ring
    have h1 := Frobenius.abs_apply_le_norm E 0 ()
    have h2 := Frobenius.abs_apply_le_norm E 2 ()
    have h3 : 1 / Δx ^ 2 ≤ |E 0 ()| + |E 2 ()| := by
      have h4 : |E 0 () - E 2 ()| = 1 / Δx ^ 2 := by
        rw [hdiff, abs_neg, abs_of_pos (by positivity)]
      rw [← h4]
      exact abs_sub _ _
    have h5 : 1 / (2 * Δx ^ 2) = (1 / Δx ^ 2) / 2 := by field_simp
    rw [h5]
    linarith

end Printed41

/-! ### The Gauss rule in the core kinetic vocabulary -/

section KineticCore

variable {N : ℕ} {μ w : Fin (N + 1) → ℝ}

/-- The weights of a Gauss rule add up to `2`, the length of `[-1, 1]`. -/
theorem IsGaussRule.sum_weight_eq_two (hG : IsGaussRule N μ w) : ∑ k, w k = 2 := by
  have h := hG.orthonormal 0 0
  simp only [ite_true, Fin.val_zero, legendre_zero] at h
  have hs : (1 / √2 : ℝ) * (1 / √2) = 1 / 2 := by
    rw [div_mul_div_comm, Real.mul_self_sqrt (by norm_num)]
    norm_num
  have h3 : ∀ k, w k * (1 / √2) * (1 / √2) = w k * (1 / 2) := fun k => by
    rw [mul_assoc, hs]
  simp only [h3, ← Finset.sum_mul] at h
  linarith

/-- **A Gauss rule as a core quadrature**: the same nodes with the halved weights `w_k / 2` are a
core `Kinetic.Quadrature`.  The rule of this file has total mass `2`, the core one has total mass
one.  The exactness on the Legendre products is not part of the core structure. -/
noncomputable def IsGaussRule.toQuadrature (hG : IsGaussRule N μ w) :
    Kinetic.Quadrature (Fin (N + 1)) where
  μ := μ
  w := fun k => w k / 2
  w_pos := fun k => div_pos (hG.weight_pos k) two_pos
  sum_w := by rw [← Finset.sum_div, hG.sum_weight_eq_two, div_self two_ne_zero]

@[simp]
theorem IsGaussRule.toQuadrature_μ (hG : IsGaussRule N μ w) : hG.toQuadrature.μ = μ := rfl

@[simp]
theorem IsGaussRule.toQuadrature_w (hG : IsGaussRule N μ w) :
    hG.toQuadrature.w = fun k => w k / 2 := rfl

/-- The bridge at a Gauss rule with two nodes, which exists by `exists_isGaussRule`. -/
example : ∃ (μ w : Fin 2 → ℝ) (hG : IsGaussRule 1 μ w),
    hG.toQuadrature.μ = μ ∧ ∑ k, hG.toQuadrature.w k = 1 := by
  obtain ⟨μ, w, hG⟩ := exists_isGaussRule 1
  exact ⟨μ, w, hG, rfl, hG.toQuadrature.sum_w⟩

end KineticCore

