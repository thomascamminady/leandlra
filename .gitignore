/.lake


# generated by scripts/build_site.py in the Pages workflow
/website/*.md
/website/docs/
/website/_site/
/_apidocs/
/website/decls.json
/.wip/

# Paper full texts are kept locally only (fetch with `make papers`); the repository keeps
# the catalogue with arXiv links (papers/catalogue.json, papers/README.md).
/papers/pdf/
/papers/txt/
/papers/statements/
/wip/

# Paper drafts and their builds stay local (owner rule); only papers/README.md and
# papers/catalogue.json are tracked.
/papers/*/
