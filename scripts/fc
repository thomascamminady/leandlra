#!/usr/bin/env bash
# Fast check of a Lean file: elaborates it on top of a saved snapshot of `import Mathlib` plus
# `import LeanDLRA`, so a check costs seconds instead of a full import.  Processes share the snapshot
# through the page cache, so many agents can run this at once.
#
#   scripts/fc FILE.lean             errors and warnings, with line numbers of FILE
#   scripts/fc --axioms FILE.lean    also fail on any axiom beyond the three standard ones
#
# The file's own imports are replaced by the snapshot header, so this checks against a SUPERSET of
# what the file imports.  It is a development convenience and NOT the gate: `make verify` (cold build
# and axiom audit) is the only thing that decides whether a proof counts.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
WARM="$ROOT/.lake/warm"
axioms=0
if [ "${1:-}" = "--axioms" ]; then axioms=1; shift; fi
f="${1:?usage: scripts/fc [--axioms] FILE.lean}"
[ -f "$f" ] || { echo "no such file: $f"; exit 2; }
[ -f "$WARM/universe.snap" ] || { echo "no snapshot: run scripts/warm.sh"; exit 2; }
# shellcheck disable=SC1091
source "$WARM/env.sh"

mkdir -p "$WARM/tmp"
tmp="$WARM/tmp/$$-$(basename "$f")"
trap 'rm -f "$tmp"' EXIT
# Lines removed before the body and lines added, so messages can quote the original line numbers.
removed=$(awk '/^(public )?(meta )?import /{n++} /^(namespace|open|noncomputable|section|theorem|lemma|def|\/-!)/{exit} END{print n+0}' "$f")
{
  cat "$WARM/header.lean"
  awk 'BEGIN{b=1} b && /^(public )?(meta )?import /{next} b && /^module *$/{next} {b=0; print}' "$f"
} > "$tmp"
if [ "$axioms" = 1 ]; then cat "$ROOT/scripts/axiom_check.lean" >> "$tmp"; fi
added=$(wc -l < "$WARM/header.lean")
# At most three checks at once. Each process needs about a gigabyte, and with more of them the machine
# evicts the memory-mapped oleans and spends its time rereading them from disk, so a queue is faster.
slot=""
mkdir -p "$WARM/slots"
trap 'rm -f "$tmp"; [ -n "$slot" ] && rmdir "$slot" 2>/dev/null' EXIT
while true; do
  find "$WARM/slots" -maxdepth 1 -name 'fc?' -mmin +15 -exec rmdir {} + 2>/dev/null
  for i in 1; do
    if mkdir "$WARM/slots/fc$i" 2>/dev/null; then slot="$WARM/slots/fc$i"; break 2; fi
  done
  sleep 3
done
start=$(date +%s)
# With many agents checking at once, per-process parallelism only adds contention.
out=$(LEAN_IMPORT_WORKERS=2 nice -n 15 lean -j2 --incr-load="$WARM/universe.snap" -DmaxSynthPendingDepth=3 "$tmp" 2>&1)
code=$?
end=$(date +%s)
echo "$out" | awk -v tmp="$tmp" -v orig="$f" -v d=$((added - removed)) '
  index($0, tmp ":") == 1 {
    rest = substr($0, length(tmp) + 2); n = index(rest, ":")
    print orig ":" (substr(rest, 1, n - 1) - d) ":" substr(rest, n + 1); next
  } { print }'
if [ "$code" = 0 ] && ! echo "$out" | grep -qE 'error|AXIOM-CHECK FAIL'; then
  if echo "$out" | grep -qE 'warning|declaration uses'; then
    echo "WARN [$f] ($((end - start)) s)"; exit 1
  fi
  echo "OK [$f] ($((end - start)) s)"
else
  echo "FAIL [$f] ($((end - start)) s)"; exit 1
fi
